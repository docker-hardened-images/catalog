#!/bin/bash
# Points the JVM at the log configuration rendered under /etc/kafka when
# KAFKA_LOG4J_OPTS is unset, then hands off to the Apache launcher.
set -e

if [ -z "${KAFKA_LOG4J_OPTS:-}" ]; then
  if [ -f /etc/kafka/log4j2.yaml ]; then
    export KAFKA_LOG4J_OPTS="-Dlog4j2.configurationFile=/etc/kafka/log4j2.yaml"
  elif [ -f /etc/kafka/log4j.properties ]; then
    export KAFKA_LOG4J_OPTS="-Dlog4j.configuration=file:/etc/kafka/log4j.properties"
  fi
fi

exec /usr/share/kafka/bin/kafka-server-start.sh "$@"
