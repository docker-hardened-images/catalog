#!/bin/bash

set -e

# gitlab-sshd serves health/metrics over HTTP on sshd.web_listen (default :9122).
# This opens a TCP connection to that port and writes a request; a successful
# connect (the daemon accepting on the port) indicates it is up. It does not
# read or assert the HTTP response.
printf 'GET /metrics HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n' \
  > "/dev/tcp/127.0.0.1/${GITLAB_SHELL_WEB_LISTEN_PORT:-9122}"
