{
    "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
    "name": "io.github.couchbase/mcp-server-couchbase",
    "description": "MCP server to interact with data in Couchbase clusters over SQL++, key-value, and cluster/schema tools; read-only by default.",
    "repository": {
      "url": "https://github.com/couchbase/mcp-server-couchbase",
      "source": "github"
    },
    "websiteUrl": "https://mcp-server.couchbase.com/",
    "version": "_VERSION_",
    "packages": [
      {
        "registryType": "oci",
        "registryBaseUrl": "https://dhi.io",
        "identifier": "couchbase-mcp:_VERSION_@__digest__",
        "version": "_VERSION_",
        "transport": { "type": "stdio" },
        "runtimeArguments": [
          { "type": "named", "name": "-i" },
          { "type": "named", "name": "--rm" }
        ],
        "environmentVariables": [
          {
            "name": "CB_CONNECTION_STRING",
            "description": "Couchbase connection string, e.g. couchbases://cb.example.com.",
            "isRequired": true
          },
          {
            "name": "CB_USERNAME",
            "description": "Couchbase username with the RBAC roles the server needs.",
            "isRequired": true
          },
          {
            "name": "CB_PASSWORD",
            "description": "Password for the Couchbase user.",
            "isRequired": true,
            "isSecret": true
          }
        ]
      }
    ]
}
