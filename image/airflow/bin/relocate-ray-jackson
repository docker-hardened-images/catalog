#!/usr/bin/env python3

# Ray shades Jackson to io.ray.shaded inside ray_dist.jar and records the
# unshaded Maven version in META-INF/maven. Replace the shaded classes with
# relocated copies of the patched jars and set that Maven version to match.

import os
import struct
import sys
import zipfile

OLD_SLASH = b"com/fasterxml/jackson"
NEW_SLASH = b"io/ray/shaded/com/fasterxml/jackson"
OLD_DOT = b"com.fasterxml.jackson"
NEW_DOT = b"io.ray.shaded.com.fasterxml.jackson"
ARTIFACTS = ("jackson-annotations", "jackson-core", "jackson-databind")


def relocate_class(data):
    if data[:4] != b"\xca\xfe\xba\xbe":
        raise SystemExit("jackson jar contains a non-class file selected for relocation")
    cp_count = struct.unpack(">H", data[8:10])[0]
    i = 10
    out = bytearray(data[:10])
    idx = 1
    while idx < cp_count:
        tag = data[i]
        if tag == 1:
            length = struct.unpack(">H", data[i + 1 : i + 3])[0]
            text = data[i + 3 : i + 3 + length]
            relocated = text.replace(OLD_SLASH, NEW_SLASH).replace(OLD_DOT, NEW_DOT)
            if len(relocated) > 65535:
                raise SystemExit("relocated Utf8 constant exceeds the class-file limit")
            out.append(1)
            out += struct.pack(">H", len(relocated))
            out += relocated
            i += 3 + length
        elif tag in (7, 8, 16, 19, 20):
            out += data[i : i + 3]
            i += 3
        elif tag in (3, 4, 9, 10, 11, 12, 17, 18):
            out += data[i : i + 5]
            i += 5
        elif tag in (5, 6):
            out += data[i : i + 9]
            i += 9
            idx += 1
        elif tag == 15:
            out += data[i : i + 4]
            i += 4
        else:
            raise SystemExit(f"unsupported class-file constant-pool tag {tag}")
        idx += 1
    out += data[i:]
    return bytes(out)


def relocate_path(name):
    if not name.endswith(".class") or name.endswith("module-info.class"):
        return None
    token = "com/fasterxml/jackson/"
    if token not in name:
        return None
    return name.replace(token, "io/ray/shaded/com/fasterxml/jackson/", 1)


def drop_entry(name):
    if name.startswith("io/ray/shaded/com/fasterxml/jackson/"):
        return True
    return name.startswith("META-INF/versions/") and "/com/fasterxml/jackson/" in name and "/io/ray/shaded/" not in name


def bundled_version(data):
    for line in data.splitlines():
        if line.startswith(b"version="):
            return line.split(b"=", 1)[1].strip()
    raise SystemExit("jackson pom.properties has no version")


def main():
    if len(sys.argv) != 6:
        raise SystemExit(f"usage: {sys.argv[0]} RAY_JAR VERSION ANNOTATIONS_JAR CORE_JAR DATABIND_JAR")
    ray_jar, version, *jars = sys.argv[1:]
    version_bytes = version.encode()

    replacements = {}
    for jar in jars:
        with zipfile.ZipFile(jar) as zf:
            for info in zf.infolist():
                dest = relocate_path(info.filename)
                if dest is None:
                    continue
                blob = relocate_class(zf.read(info))
                if dest in replacements:
                    raise SystemExit(f"duplicate relocated class {dest}")
                replacements[dest] = blob
    if len(replacements) < 100:
        raise SystemExit(f"expected the patched jackson jars to yield classes, got {len(replacements)}")

    with zipfile.ZipFile(ray_jar) as zf:
        old_version = bundled_version(zf.read("META-INF/maven/com.fasterxml.jackson.core/jackson-core/pom.properties"))
    if old_version == version_bytes:
        raise SystemExit(f"ray_dist.jar already contains jackson {version}")

    tmp = ray_jar + ".tmp"
    with zipfile.ZipFile(ray_jar) as zin, zipfile.ZipFile(tmp, "w") as zout:
        for info in zin.infolist():
            data = zin.read(info)
            if drop_entry(info.filename):
                continue
            if info.filename.startswith("META-INF/maven/com.fasterxml.jackson.core/") and info.filename.endswith((".properties", ".xml")):
                data = data.replace(old_version, version_bytes)
            new = zipfile.ZipInfo(filename=info.filename, date_time=info.date_time)
            new.compress_type = info.compress_type
            new.external_attr = info.external_attr
            zout.writestr(new, data)
        for dest, blob in replacements.items():
            new = zipfile.ZipInfo(filename=dest)
            new.compress_type = zipfile.ZIP_DEFLATED
            zout.writestr(new, blob)

    with zipfile.ZipFile(tmp) as zf:
        names = zf.namelist()
        leftover = [name for name in names if "v2_18_8" in name or (name.startswith("META-INF/versions/") and "/com/fasterxml/jackson/" in name and "/io/ray/shaded/" not in name)]
        if leftover:
            raise SystemExit("jackson 2.18.8 entries remain: " + ", ".join(leftover[:8]))
        for artifact in ARTIFACTS:
            got = bundled_version(zf.read(f"META-INF/maven/com.fasterxml.jackson.core/{artifact}/pom.properties"))
            if got != version_bytes:
                raise SystemExit(f"{artifact} metadata is {got.decode()} after relocation")
        number_input = zf.read("io/ray/shaded/com/fasterxml/jackson/core/io/NumberInput.class")
        fdp_token = b"fdp/v" + version_bytes.replace(b".", b"_") + b"/"
        if fdp_token not in number_input:
            raise SystemExit("relocated jackson-core does not reference the patched fast-double-parser package")
        if "io/ray/shaded/com/fasterxml/jackson/databind/ObjectMapper.class" not in names:
            raise SystemExit("relocated jackson-databind is missing ObjectMapper")

    os.replace(tmp, ray_jar)


if __name__ == "__main__":
    main()
