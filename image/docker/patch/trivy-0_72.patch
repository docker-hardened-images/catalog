+func TestTrivyTransport(t *testing.T) {
+	proxyURL := &url.URL{Scheme: "http", Host: "desktop-proxy"}
+	base := &http.Transport{Proxy: http.ProxyURL(proxyURL)}
+
+	transport, err := newTrivyTransport(base)
+	if err != nil {
+		t.Fatal(err)
+	}
+	built, ok := transport.Build(xhttp.WithInsecure(true)).(*http.Transport)
+	if !ok {
+		t.Fatalf("expected *http.Transport, got %T", built)
+	}
+	if built == base {
+		t.Fatal("expected the base transport to be cloned")
+	}
+	if base.TLSClientConfig != nil && base.TLSClientConfig.InsecureSkipVerify {
+		t.Fatal("expected Trivy options not to mutate the Desktop transport")
+	}
+	if built.TLSClientConfig == nil || !built.TLSClientConfig.InsecureSkipVerify {
+		t.Fatal("expected Trivy transport options to be applied")
+	}
+	gotProxy, err := built.Proxy(&http.Request{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if gotProxy.String() != proxyURL.String() {
+		t.Fatalf("expected Desktop proxy %q, got %q", proxyURL, gotProxy)
+	}
+}
+
+func TestTemporaryFSCache(t *testing.T) {
+	first, err := newTemporaryFSCache()
+	if err != nil {
+		t.Fatal(err)
+	}
+	firstCache := first.(*temporaryFSCache)
+	t.Cleanup(func() { _ = firstCache.Close() })
+
+	second, err := newTemporaryFSCache()
+	if err != nil {
+		t.Fatal(err)
+	}
+	secondCache := second.(*temporaryFSCache)
+	t.Cleanup(func() { _ = secondCache.Close() })
+
+	if firstCache.directory == secondCache.directory {
+		t.Fatalf("expected isolated cache directories, both used %q", firstCache.directory)
+	}
+	for _, directory := range []string{firstCache.directory, secondCache.directory} {
+		if _, err := os.Stat(filepath.Join(directory, "fanal", "fanal.db")); err != nil {
+			t.Fatalf("expected filesystem cache in %q: %v", directory, err)
+		}
+	}
+
+	if err := firstCache.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(firstCache.directory); !os.IsNotExist(err) {
+		t.Fatalf("expected first cache directory to be removed, got %v", err)
+	}
+	if _, err := os.Stat(secondCache.directory); err != nil {
+		t.Fatalf("expected second cache to remain available: %v", err)
+	}
+
+	if err := secondCache.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(secondCache.directory); !os.IsNotExist(err) {
+		t.Fatalf("expected second cache directory to be removed, got %v", err)
+	}
+}
+
+func TestIndexPropagatesMavenRateLimit(t *testing.T) {
+	t.Setenv(internal.OfflineEnvName, "false")
+
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		w.Header().Set("Retry-After", "1800")
+		w.WriteHeader(http.StatusTooManyRequests)
+	}))
+	t.Cleanup(server.Close)
+
+	directory := t.TempDir()
+	pom := fmt.Sprintf(`<project xmlns="http://maven.apache.org/POM/4.0.0">
+  <modelVersion>4.0.0</modelVersion>
+  <groupId>com.example</groupId>
+  <artifactId>rate-limited</artifactId>
+  <version>1.0.0</version>
+  <repositories>
+    <repository>
+      <id>rate-limited</id>
+      <url>%s</url>
+    </repository>
+  </repositories>
+  <dependencies>
+    <dependency>
+      <groupId>org.example</groupId>
+      <artifactId>dependency</artifactId>
+      <version>1.2.3</version>
+    </dependency>
+  </dependencies>
+</project>`, server.URL)
+	if err := os.WriteFile(filepath.Join(directory, "pom.xml"), []byte(pom), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	results := make(chan types.IndexResult, 1)
+	Index(t.Context(), &images.ImageCache{ImagePath: directory}, &types.LayerMapping{}, false, nil, results)
+	result := <-results
+	if result.Status != types.Failed {
+		t.Fatalf("expected Maven rate limit to fail indexing, got status %q", result.Status)
+	}
+	if result.Error == nil {
+		t.Fatal("expected Maven rate limit error")
+	}
+	for _, expected := range []string{"429 Too Many Requests", "Retry-After: 1800"} {
+		if !strings.Contains(result.Error.Error(), expected) {
+			t.Fatalf("expected error to contain %q, got %v", expected, result.Error)
+		}
+	}
+}
