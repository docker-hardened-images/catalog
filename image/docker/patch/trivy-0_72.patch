@@ -289,14 +291,72 @@ func initializeCache() (cache.Cache, error) {
 	// honours the HTTP(S)_PROXY environment variables. Route it through the
 	// Docker Desktop proxy transport so it behaves like the rest of the plugin
 	// and works behind a Desktop-configured proxy.
-	xhttp.SetDefaultTransport(desktop.ProxyTransport())
+	transport, err := newTrivyTransport(desktop.ProxyTransport())
+	if err != nil {
+		return nil, err
+	}
+	xhttp.SetDefaultTransport(transport)
 
 	repo, err := name.NewTag(javadb.DefaultGHCRRepository)
 	if err != nil {
 		return nil, err
 	}
 	javadb.Init(utils.CacheDir(), []name.Reference{repo}, false, true, stypes.RegistryOptions{Insecure: false})
-	return cache.NewFSCache(utils.CacheDir())
+	return newTemporaryFSCache()
+}
+
+type temporaryFSCache struct {
+	cache.Cache
+	directory string
+}
+
+func newTemporaryFSCache() (cache.Cache, error) {
+	directory, err := os.MkdirTemp("", "docker-scout-trivy-cache-*")
+	if err != nil {
+		return nil, fmt.Errorf("failed to create temporary Trivy cache: %w", err)
+	}
+
+	fsCache, err := cache.NewFSCache(directory)
+	if err != nil {
+		if removeErr := os.RemoveAll(directory); removeErr != nil {
+			return nil, errors.Join(err, fmt.Errorf("failed to remove temporary Trivy cache: %w", removeErr))
+		}
+		return nil, err
+	}
+
+	return &temporaryFSCache{
+		Cache:     fsCache,
+		directory: directory,
+	}, nil
+}
+
+func (c *temporaryFSCache) Close() error {
+	closeErr := c.Cache.Close()
+	removeErr := os.RemoveAll(c.directory)
+	if removeErr != nil {
+		removeErr = fmt.Errorf("failed to remove temporary Trivy cache: %w", removeErr)
+	}
+	return errors.Join(closeErr, removeErr)
+}
+
+type trivyTransport struct {
+	base *http.Transport
+}
+
+func (t trivyTransport) Build(opts ...xhttp.TransportOption) http.RoundTripper {
+	transport := t.base.Clone()
+	for _, opt := range opts {
+		opt(transport)
+	}
+	return transport
+}
+
+func newTrivyTransport(base http.RoundTripper) (xhttp.Transport, error) {
+	transport, ok := base.(*http.Transport)
+	if !ok {
+		return nil, fmt.Errorf("unsupported Docker Desktop proxy transport %T", base)
+	}
+	return trivyTransport{base: transport}, nil
 }
 
