Backport Apache Kafka PR #22898 to replace the aggregate JLine bundle with
the modules used by Kafka's metadata shell. The bundle includes unused
built-ins and remote Telnet/SSH code that causes scanners to report JLine
vulnerabilities even though Kafka does not expose those capabilities.

Use JLine 3.30.17, the current fixed 3.x security release.

Upstream: https://github.com/apache/kafka/pull/22898
Release: https://github.com/jline/jline3/releases/tag/jline-3.30.17

diff --git a/LICENSE-binary b/LICENSE-binary
--- a/LICENSE-binary
+++ b/LICENSE-binary
@@ -314,4 +314,6 @@ BSD 3-Clause
 
-- jline-3.30.4, see: licenses/jline-BSD-3-clause
+- jline-native-3.30.17, see: licenses/jline-BSD-3-clause
+- jline-reader-3.30.17, see: licenses/jline-BSD-3-clause
+- jline-terminal-3.30.17, see: licenses/jline-BSD-3-clause
 - protobuf-java-3.25.5, see: licenses/protobuf-java-BSD-3-clause
 - jakarta.activation-2.0.1, see: licenses/jakarta-BSD-3-clause
diff --git a/gradle/dependencies.gradle b/gradle/dependencies.gradle
--- a/gradle/dependencies.gradle
+++ b/gradle/dependencies.gradle
@@ -71,3 +71,3 @@ versions += [
-  jline: "3.30.4",
+  jline: "3.30.17",
   jmh: "1.37",
   hamcrest: "3.0",
@@ -175,3 +175,3 @@ libs += [
-  jline: "org.jline:jline:$versions.jline",
+  jline: "org.jline:jline-reader:$versions.jline",
   jmhCore: "org.openjdk.jmh:jmh-core:$versions.jmh",
   jmhCoreBenchmarks: "org.openjdk.jmh:jmh-core-benchmarks:$versions.jmh",
