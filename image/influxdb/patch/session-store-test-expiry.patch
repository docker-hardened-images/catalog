Widen TestSessionExpireAt short expiry window for CI scheduler latency.

Upstream sets a 100µs future expiry then immediately Get(); under load the
session can appear expired before Get runs. Same assertion with a stable window.

https://github.com/influxdata/influxdb/blob/v2.9.1/inmem/session_store_test.go

diff --git a/inmem/session_store_test.go b/inmem/session_store_test.go
index d4fb46e..3ded7d0 100644
--- a/inmem/session_store_test.go
+++ b/inmem/session_store_test.go
@@ -120,7 +120,7 @@ func TestSessionExpireAt(t *testing.T) {
 		t.Fatal(err)
 	}
 
-	if err := st.ExpireAt("yo", time.Now().Add(100*time.Microsecond)); err != nil {
+	if err := st.ExpireAt("yo", time.Now().Add(500*time.Millisecond)); err != nil {
 		t.Fatal(err)
 	}
 
