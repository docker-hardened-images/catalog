index 0000000..5a13751
--- /dev/null
+++ b/packages/cli-v3/src/build/forcedExternalResolve.esbuild.test.ts
@@ -0,0 +1,133 @@
+import * as esbuild from "esbuild";
+import { mkdir, mkdtemp, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import {
+  classifyForcedImport,
+  forcedExternalPattern,
+  importPackageName,
+  type ForcedExternal,
+} from "./forcedExternalResolve.js";
+
+function assert(condition: boolean, message: string): void {
+  if (!condition) {
+    throw new Error(message);
+  }
+}
+
+async function writePackage(root: string, name: string): Promise<void> {
+  const dir = join(root, "node_modules", ...name.split("/"));
+  await mkdir(dir, { recursive: true });
+  await writeFile(join(dir, "package.json"), JSON.stringify({ name, version: "1.0.0" }));
+  await writeFile(join(dir, "index.js"), "export default 1;\n");
+}
+
+async function resolveSequence(
+  root: string,
+  external: ForcedExternal,
+  paths: string[],
+): Promise<Map<string, boolean>> {
+  const collected: { name: string }[] = [];
+  const seen = new Map<string, boolean>();
+
+  await esbuild.build({
+    absWorkingDir: root,
+    stdin: { contents: "export {}\n", sourcefile: "entry.js", loader: "js" },
+    bundle: true,
+    write: false,
+    format: "esm",
+    platform: "node",
+    logLevel: "silent",
+    plugins: [
+      {
+        name: "forced-external",
+        setup(build) {
+          build.onResolve({ filter: external.filter, namespace: "file" }, (args) => {
+            const decision = classifyForcedImport(external, collected, args.path);
+            if (decision.kind === "skip") {
+              return undefined;
+            }
+            if (decision.kind === "fast") {
+              return { external: true };
+            }
+
+            const packageName = importPackageName(args.path);
+            if (!external.filter.test(packageName)) {
+              return undefined;
+            }
+
+            collected.push({ name: packageName });
+            return { external: true };
+          });
+        },
+      },
+      {
+        name: "probe",
+        setup(build) {
+          build.onStart(async () => {
+            for (const path of paths) {
+              const result = await build.resolve(path, {
+                resolveDir: root,
+                kind: "import-statement",
+                namespace: "file",
+              });
+              if (result.errors.length > 0) {
+                throw new Error(
+                  `resolve ${path}: ${result.errors.map((error) => error.text).join("; ")}`,
+                );
+              }
+              seen.set(path, result.external === true);
+            }
+          });
+        },
+      },
+    ],
+  });
+
+  return seen;
+}
+
+async function main(): Promise<void> {
+  const root = await mkdtemp(join(tmpdir(), "forced-external-"));
+  for (const name of ["left-pad", "react", "header-generator", "import-in-the-middle"]) {
+    await writePackage(root, name);
+  }
+
+  assert(forcedExternalPattern("# comment") === undefined, "comment patterns are skipped");
+  assert(forcedExternalPattern("") === undefined, "empty patterns are skipped");
+
+  const literal = forcedExternalPattern("left-pad");
+  if (!literal) {
+    throw new Error("literal pattern");
+  }
+  const literalSource = new RegExp(literal.filter.source);
+  assert(literalSource.test("left-pad"), "literal source matches the package");
+  assert(literalSource.test("left-pad/index.js"), "literal source matches a subpath");
+  assert(!literalSource.test("react"), "literal source does not match an unrelated import");
+  assert(!literalSource.test("left-padding"), "literal source does not match a prefix");
+
+  const literalSeen = await resolveSequence(root, literal, ["left-pad", "left-pad/index.js", "react"]);
+  assert(literalSeen.get("left-pad") === true, "left-pad is external");
+  assert(literalSeen.get("left-pad/index.js") === true, "later subpath import stays external");
+  assert(literalSeen.get("react") === false, "unrelated import after a literal match is not external");
+
+  const brace = forcedExternalPattern("{import-in-the-middle,header-generator}");
+  if (!brace) {
+    throw new Error("brace pattern");
+  }
+  const braceSeen = await resolveSequence(root, brace, [
+    "header-generator",
+    "react",
+    "import-in-the-middle",
+  ]);
+  assert(braceSeen.get("header-generator") === true, "brace alternative is external");
+  assert(braceSeen.get("react") === false, "unrelated import after a brace match is not external");
+  assert(braceSeen.get("import-in-the-middle") === true, "other brace alternative is external");
+
+  console.log("forced-external esbuild regression ok");
+}
+
+main().catch((error: unknown) => {
+  console.error(error);
+  process.exit(1);
+});
diff --git a/packages/cli-v3/src/build/forcedExternalResolve.ts b/packages/cli-v3/src/build/forcedExternalResolve.ts
new file mode 100644
index 0000000..ca219e2
--- /dev/null
+++ b/packages/cli-v3/src/build/forcedExternalResolve.ts
@@ -0,0 +1,82 @@
+import { Minimatch } from "minimatch";
+
+export type ForcedExternal = {
+  raw: string;
+  filter: RegExp;
+};
+
+export type ForcedImportDecision = { kind: "skip" } | { kind: "fast" } | { kind: "resolve" };
+
+// npm package names this image forces external are literals. Anything else
+// (braces, extglobs, stars) is a minimatch pattern. minimatch 11 does not
+// compile those to a regexp.
+const LITERAL_PACKAGE_NAME = /^(?:@[A-Za-z0-9_.-]+\/)?[A-Za-z0-9_.-]+$/;
+
+function escapeRegExp(value: string): string {
+  return value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
+}
+
+// Same split as packageNameForImportPath in externals.ts.
+export function importPackageName(importPath: string): string {
+  const withoutAtSign = importPath.replace(/^@/, "");
+  const parts = withoutAtSign.split("/");
+
+  if (importPath.startsWith("@")) {
+    return "@" + parts.slice(0, 2).join("/");
+  }
+
+  return parts[0] ?? "";
+}
+
+function matchesPattern(externalName: string, matcher: Minimatch, path: string): boolean {
+  if (path === externalName || matcher.match(path)) {
+    return true;
+  }
+
+  const packageName = importPackageName(path);
+  if (packageName === path) {
+    return false;
+  }
+
+  return packageName === externalName || matcher.match(packageName);
+}
+
+export function forcedExternalPattern(externalName: string): ForcedExternal | undefined {
+  const matcher = new Minimatch(externalName);
+  if (matcher.comment || matcher.empty) {
+    return undefined;
+  }
+
+  const escaped = escapeRegExp(externalName);
+  // esbuild 0.23 sends filter.source to the Go resolver and never calls
+  // RegExp.test. Literal names can be expressed directly, including subpaths.
+  // Glob patterns stay match-all here; matchesPattern is installed as test()
+  // for the callback, which is the only place that method runs.
+  const filter = LITERAL_PACKAGE_NAME.test(externalName)
+    ? new RegExp(`^${escaped}(?:/.*)?$`)
+    : /(?:)/;
+
+  Object.defineProperty(filter, "test", {
+    value: (path: string) => matchesPattern(externalName, matcher, path),
+  });
+
+  return { raw: externalName, filter };
+}
+
+export function classifyForcedImport(
+  external: ForcedExternal,
+  externals: ReadonlyArray<{ name: string }>,
+  importPath: string,
+): ForcedImportDecision {
+  if (!external.filter.test(importPath)) {
+    return { kind: "skip" };
+  }
+
+  // Once this pattern has been collected, the fast path marks every later
+  // callback hit external. That is only safe when the hit is this pattern.
+  if (externals.some((entry) => entry.name === external.raw)) {
+    return { kind: "fast" };
+  }
+
+  return { kind: "resolve" };
+}
