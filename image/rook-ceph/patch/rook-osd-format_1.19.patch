Subject: osd: use %d not %q for OSDsPerDevice (int) in parseDevices
Go 1.26's vet printf analyzer rejects %q unless the argument is a string,
byte slice, or rune. d.OSDsPerDevice is an int, so v1.18/v1.19 fail
compile-time checks on golang-1.26. Change the verb to %d.
Upstream source: https://github.com/rook/rook/commit/a9c1805ae31d1bc0786be8725662f5b2a4e6bacf
(from https://github.com/rook/rook/pull/17547; present in v1.20, not in v1.18/v1.19)

diff --git a/cmd/rook/ceph/osd.go b/cmd/rook/ceph/osd.go
index 82da362..69388c9 100644
--- a/cmd/rook/ceph/osd.go
+++ b/cmd/rook/ceph/osd.go
@@ -390,7 +390,7 @@ func parseDevices(devices string) ([]osddaemon.DesiredDevice, error) {
 		d.MetadataDevice = cd.StoreConfig.MetadataDevice
 
 		if d.OSDsPerDevice < 1 {
-			return nil, errors.Errorf("osds per device should be greater than 0 (%q)", d.OSDsPerDevice)
+			return nil, errors.Errorf("osds per device should be greater than 0 (%d)", d.OSDsPerDevice)
 		}
 
 		result = append(result, d)
