{
    "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
    "name": "io.github.webflow/mcp-server",
    "description": "Official Webflow MCP server exposing the Webflow Data API (sites, CMS collections, pages, components) to MCP clients.",
    "repository": {
      "url": "https://github.com/webflow/mcp-server",
      "source": "github"
    },
    "version": "_VERSION_",
    "packages": [
      {
        "registryType": "oci",
        "registryBaseUrl": "https://dhi.io",
        "identifier": "webflow-mcp:_VERSION_@__digest__",
        "version": "_VERSION_",
        "transport": { "type": "stdio" },
        "runtimeArguments": [
          { "type": "named", "name": "--rm" },
          { "type": "named", "name": "-i" }
        ],
        "environmentVariables": [
          {
            "name": "WEBFLOW_TOKEN",
            "description": "Webflow API token. The server exits if this is absent.",
            "isRequired": true,
            "isSecret": true
          }
        ]
      }
    ]
  }
