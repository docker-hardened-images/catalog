Subject: Load Ceph 19 mgr modules in the main Python interpreter

Load Ceph 19 mgr modules in the main Python interpreter so PyO3 extensions such as cryptography can import. Ceph 19 otherwise creates one subinterpreter per module, and cryptography 41 and newer raise ImportError there.
Origin: backport, https://github.com/ceph/ceph/commit/239b0dc8a9c42449ee1faa1bf78bdcc380345ae2
Base-Tree: git https://github.com/ceph/ceph.git 9ec952b9f9668e9fa97e29a4c2b51e951674df2a
Adaptation: Drop the upstream CMakeLists.txt empty default and the Py_EndInterpreter destructor edit, because v19.2.7 has no such destructor call and y2c rejects an empty option default. Use default " " so y2c emits set_default(""). Initialize argv and mgr_module_path once on the shared interpreter in PyModuleRegistry, and keep the Debian 13 sys.path insert.
Verify: test tests/ceph_test.go::TestCephWithRookOperator

diff --git a/src/common/options/mgr.yaml.in b/src/common/options/mgr.yaml.in
--- a/src/common/options/mgr.yaml.in
+++ b/src/common/options/mgr.yaml.in
@@ -167,6 +167,20 @@
   - mgr_module_path
   flags:
   - startup
+- name: mgr_subinterpreter_modules
+  type: str
+  level: advanced
+  desc: List of manager modules to load in independent subinterpreters
+  long_desc: A comma delimited list of module names. This list is read by manager
+    when it starts. By default, manager loads each module into the main interpreter
+    so PyO3 extensions such as cryptography can import. Modules in this list are
+    loaded into independent subinterpreters instead. Specifying '*' loads every
+    module in its own subinterpreter.
+  default: " "
+  services:
+  - mgr
+  flags:
+  - startup
 - name: mgr_initial_modules
   type: str
   level: basic
diff --git a/src/mgr/PyModule.cc b/src/mgr/PyModule.cc
--- a/src/mgr/PyModule.cc
+++ b/src/mgr/PyModule.cc
@@ -21,8 +21,11 @@

 #include "include/stringify.h"
 #include "common/BackTrace.h"
+#include "common/split.h"
 #include "global/signal_handler.h"

+#include <algorithm>
+
 #include "common/debug.h"
 #include "common/errno.h"
 #define dout_context g_ceph_context
@@ -346,8 +349,25 @@
 {
   ceph_assert(pMainThreadState != nullptr);

-  // Configure sub-interpreter
-  {
+  // cryptography (via PyO3) refuses to initialize in a subinterpreter.
+  // Ceph 19 loads each mgr module in its own subinterpreter, which makes
+  // restful fail once cryptography is new enough to fix the Python CVEs.
+  // https://github.com/ceph/ceph/commit/239b0dc8a9c42449ee1faa1bf78bdcc380345ae2
+  const auto subinterpreter_modules_opt = g_conf().get_val<std::string>(
+    "mgr_subinterpreter_modules"
+  );
+  auto subinterpreter_modules = ceph::split(subinterpreter_modules_opt);
+  const bool use_main_interpreter = std::count(
+    subinterpreter_modules.begin(), subinterpreter_modules.end(), "*"
+  ) == 0 && std::count(
+    subinterpreter_modules.begin(), subinterpreter_modules.end(), module_name
+  ) == 0;
+
+  if (use_main_interpreter) {
+    dout(1) << "Loading module '" << module_name << "' in the main interpreter" << dendl;
+    pMyThreadState.set(pMainThreadState);
+  } else {
+    // Configure sub-interpreter
     SafeThreadState sts(pMainThreadState);
     Gil gil(sts);

diff --git a/src/mgr/PyModuleRegistry.cc b/src/mgr/PyModuleRegistry.cc
--- a/src/mgr/PyModuleRegistry.cc
+++ b/src/mgr/PyModuleRegistry.cc
@@ -54,6 +54,21 @@
   }
   PyImport_AppendInittab("ceph_module", PyModule::init_ceph_module);
   Py_InitializeEx(0);
+  // Subinterpreters set argv and sys.path in PyModule::load. The main
+  // interpreter is shared, so do it once here. PyO3 extensions such as
+  // cryptography cannot import in a subinterpreter.
+  {
+    const wchar_t *argv[] = {L"ceph-mgr"};
+    PySys_SetArgv(1, (wchar_t**)argv);
+    const std::string module_path = g_conf().get_val<std::string>("mgr_module_path");
+    auto py_sys_path = PySys_GetObject("path");
+    ceph_assert(py_sys_path);
+    ceph_assert(PyList_Check(py_sys_path));
+    auto py_path = PyUnicode_FromString(module_path.c_str());
+    ceph_assert(py_path);
+    ceph_assert(PyList_Insert(py_sys_path, 0, py_path) == 0);
+    Py_DECREF(py_path);
+  }
 #if PY_VERSION_HEX < 0x03090000
   // Let CPython know that we will be calling it back from other
   // threads in future.
