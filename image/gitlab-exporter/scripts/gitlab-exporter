#!/bin/sh
# gitlab-exporter is vendored under /usr/lib/gitlab-exporter with its dependency
# gems installed (by bundler, at the versions pinned in the committed
# Gemfile.lock) into a standard gem layout at vendor/bundle/ruby/<abi>. GEM_PATH
# (set on the image) points the /usr/local Ruby at that dir, so only the locked
# gem versions are resolvable; -I puts the app's own lib on the load path.
exec ruby -I /usr/lib/gitlab-exporter/lib /usr/lib/gitlab-exporter/bin/gitlab-exporter "$@"
