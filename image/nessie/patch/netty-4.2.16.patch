Force Netty 4.2.16.Final to resolve multiple CVEs against Quarkus BOM overrides.
https://github.com/netty/netty/releases/tag/netty-4.2.16.Final
Pinned per gradle/libs.versions.toml in Nessie 0.108.1.
diff --git a/servers/quarkus-server/build.gradle.kts b/servers/quarkus-server/build.gradle.kts
--- a/servers/quarkus-server/build.gradle.kts
+++ b/servers/quarkus-server/build.gradle.kts
@@ -30,6 +30,41 @@
 
 publishingHelper { mavenName = "Nessie - Quarkus Server" }
 
+// Quarkus platform constraints and Nessie's declared Netty version still allow dependency
+// resolution to select older, vulnerable Netty releases. Force every Netty artifact to a
+// fixed version so the Quarkus fast-jar packaging includes the correct jar filenames and
+// scanners/SBOM reflect the patched release. Pinned to 4.2.16.Final to resolve multiple CVEs
+// (CVE-2026-55831, CVE-2026-55833, CVE-2026-55851, CVE-2026-56745, CVE-2026-56746,
+// CVE-2026-59898, CVE-2026-59899, CVE-2026-59900, CVE-2026-59901, CVE-2026-59919,
+// CVE-2026-59921).
+configurations.configureEach {
+  resolutionStrategy {
+    force(
+      "io.netty:netty-buffer:4.2.16.Final",
+      "io.netty:netty-codec-compression:4.2.16.Final",
+      "io.netty:netty-codec-dns:4.2.16.Final",
+      "io.netty:netty-codec-haproxy:4.2.16.Final",
+      "io.netty:netty-codec-http2:4.2.16.Final",
+      "io.netty:netty-codec-http:4.2.16.Final",
+      "io.netty:netty-codec-socks:4.2.16.Final",
+      "io.netty:netty-codec:4.2.16.Final",
+      "io.netty:netty-common:4.2.16.Final",
+      "io.netty:netty-handler-proxy:4.2.16.Final",
+      "io.netty:netty-handler:4.2.16.Final",
+      "io.netty:netty-resolver-dns-classes-macos:4.2.16.Final",
+      "io.netty:netty-resolver-dns-native-macos:4.2.16.Final",
+      "io.netty:netty-resolver-dns:4.2.16.Final",
+      "io.netty:netty-resolver:4.2.16.Final",
+      "io.netty:netty-transport-classes-epoll:4.2.16.Final",
+      "io.netty:netty-transport-classes-kqueue:4.2.16.Final",
+      "io.netty:netty-transport-native-epoll:4.2.16.Final",
+      "io.netty:netty-transport-native-kqueue:4.2.16.Final",
+      "io.netty:netty-transport-native-unix-common:4.2.16.Final",
+      "io.netty:netty-transport:4.2.16.Final",
+    )
+  }
+}
+
 // GHSA-r7wm-3cxj-wff9, CVE-2026-54515, CVE-2026-59889: Quarkus platform constraints can still pull Jackson below the
 // jackson-bom version declared in gradle/libs.versions.toml. Force the Jackson core trio
 // so the Quarkus fast-jar packaging and SBOM reflect the fixed release.
