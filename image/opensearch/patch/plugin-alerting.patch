Subject: Bump httpclient5 for CVE remediation in the Alerting plugin
Upstream source: https://github.com/opensearch-project/alerting/blob/3.8.0.0/build.gradle
Patched dependency: https://repo.maven.apache.org/maven2/org/apache/httpcomponents/client5/httpclient5/5.6.3/
Description: The Alerting plugin root build.gradle hard-forces httpclient5 5.6.1 in
  allprojects resolutionStrategy, which wins over the DHI Gradle init script and the
  OpenSearch version catalog bump. Pin httpclient5 to 5.6.3 for CVE-2026-64607.

diff --git a/build.gradle b/build.gradle
--- a/build.gradle
+++ b/build.gradle
@@ -134,5 +134,5 @@
             force "org.apache.logging.log4j:log4j-api:2.25.4"
             force "org.apache.logging.log4j:log4j-core:2.25.4"
-            force "org.apache.httpcomponents.client5:httpclient5:5.6.1"
+            force "org.apache.httpcomponents.client5:httpclient5:5.6.3"
         }
     }
