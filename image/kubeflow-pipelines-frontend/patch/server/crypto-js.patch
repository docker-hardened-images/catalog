Subject: Replace crypto-js SHA1 with node crypto

Kubeflow Pipelines names tensorboard viewer resources with crypto-js SHA1. This build drops that dependency and uses the node crypto module for the same call site.

Origin: DHI-internal (kubeflow pipelines frontend server)
Description: Drop crypto-js and hash viewer names with node crypto.
Advisory: https://github.com/brix/crypto-js/security/advisories/GHSA-xwcq-pm8m-c4vf
CVE: CVE-2023-46233
Base-Tree: git https://github.com/kubeflow/pipelines 555bfa60a70da88c594960bdacfd78fa7c061043 path=frontend/server
Verify: test k8s-helper.ts
Forwarded: not-needed (build-time replacement of the crypto-js import)
Drop-When: never: Kubeflow Pipelines 2.18.0 still imports crypto-js to name viewer resources

--- a/k8s-helper.ts
+++ b/k8s-helper.ts
@@ -19,7 +19,7 @@
   V1Pod,
   V1ConfigMap,
 } from '@kubernetes/client-node';
-import crypto from 'crypto-js';
+import * as crypto from 'crypto';
 import * as fs from 'fs';
 import { PartialArgoWorkflow } from './workflow-helper.js';
 import { findFileOnPodVolume, isAllowedResourceName } from './utils.js';
@@ -80,7 +80,8 @@
 
 function getNameOfViewerResource(logdir: string): string {
   // TODO: find some hash function with shorter resulting message.
-  return 'viewer-' + crypto.SHA1(logdir);
+  const hash = crypto.createHmac('sha1', logdir)
+  return 'viewer-' + hash.digest('hex');
 }
 
 function unwrapCustomObject<T>(resource: T | { body?: T } | undefined | null): T | undefined {
