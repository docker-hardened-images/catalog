#!/bin/bash
# Replaces confluent-kafka's zookeeper-server-start:
# https://github.com/confluentinc/kafka/blob/v7.9.9/bin/zookeeper-server-start.sh
set -e

if [ $# -lt 1 ]; then
    echo "USAGE: $0 [-daemon] zookeeper.properties" >&2
    exit 1
fi

if [ "$1" = "-daemon" ]; then
    # Upstream forwards -daemon to kafka-run-class, which starts the JVM under
    # nohup. A container needs it in the foreground as pid 1's child.
    echo "zookeeper-server-start: -daemon is not supported in a container; running in the foreground" >&2
    shift
fi

# Upstream sets this here, not in kafka-run-class, so only the server gets 512M.
if [ -z "${KAFKA_HEAP_OPTS:-}" ]; then
    export KAFKA_HEAP_OPTS="-Xmx512M -Xms512M"
fi

# Upstream also passes "-name zookeeper -loggc" (GC logs under /var/log/kafka,
# absent here) and sets KAFKA_LOG4J_OPTS, which zookeeper-run-class ignores in
# favour of logback.
exec zookeeper-run-class org.apache.zookeeper.server.quorum.QuorumPeerMain "$@"
