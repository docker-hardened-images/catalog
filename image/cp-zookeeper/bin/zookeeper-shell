#!/bin/bash
# Replaces confluent-kafka's zookeeper-shell:
# https://github.com/confluentinc/kafka/blob/v7.9.9/bin/zookeeper-shell.sh
# That runs ZooKeeperMainWithTlsSupportForKafka, a class from Kafka's own jar
# that adds -zk-tls-config-file. No Kafka jars here, so this runs ZooKeeper's
# ZooKeeperMain, which takes TLS settings through -client-configuration:
# https://zookeeper.apache.org/doc/r3.8.6/zookeeperCLI.html
set -e

if [ $# -lt 1 ]; then
    echo "USAGE: $0 zookeeper_host:port[/path] [-client-configuration properties-file] [cmd args...]" >&2
    exit 1
fi

exec zookeeper-run-class org.apache.zookeeper.ZooKeeperMain -server "$@"
