Subject: Declare failureaccess for DHI Guava 33.x on Cassandra 4.0 build.xml
Origin: DHI-internal (cassandra image CVE remediation)
Description: Guava 32.x and later ship failureaccess as a separate runtime jar,
  while Cassandra 4.0 build.xml still excludes it because upstream pinned Guava
  27.0-jre bundled failureaccess internally. After cassandra-4-mvn-dependencies.json
  rewrites Guava to 33.7.2-jre, this patch adds the explicit failureaccess
  dependency and removes the stale exclusion so the Ant dependency block matches
  the versions already rewritten for snappy-java and lz4-java.
Base-Tree: git https://github.com/apache/cassandra 172099f4a8c1316da35ca77eab19aea535936a6d
Forwarded: not-needed (DHI build.xml wiring only)
Verify: cmd `dhi def build --fast image/cassandra/debian-13/4.0.yaml` expect "Indexed"
Drop-When: never: required while DHI overrides Guava on Cassandra 4.0.x build.xml

diff --git a/build.xml b/build.xml
index bb5b50e..8d90e2c 100644
--- a/build.xml
+++ b/build.xml
@@ -548,11 +548,11 @@
           <dependency groupId="org.xerial.snappy" artifactId="snappy-java" version="1.1.10.9"/>
           <dependency groupId="at.yawk.lz4" artifactId="lz4-java" version="1.11.4"/>
           <dependency groupId="com.github.luben" artifactId="zstd-jni" version="1.5.7-2"/>
+          <dependency groupId="com.google.guava" artifactId="failureaccess" version="1.0.2"/>
           <dependency groupId="com.google.guava" artifactId="guava" version="33.7.2-jre">
             <exclusion groupId="com.google.code.findbugs" artifactId="jsr305" />
             <exclusion groupId="org.codehaus.mojo" artifactId="animal-sniffer-annotations" />
             <exclusion groupId="com.google.guava" artifactId="listenablefuture" />
-            <exclusion groupId="com.google.guava" artifactId="failureaccess" />
             <exclusion groupId="org.checkerframework" artifactId="checker-qual" />
             <exclusion groupId="com.google.errorprone" artifactId="error_prone_annotations" />
           </dependency>
