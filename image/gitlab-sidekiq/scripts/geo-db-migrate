# https://gitlab.com/gitlab-org/build/CNG/-/blob/master/gitlab-rails/scripts/geo-db-migrate

set -e

hr="$(printf '=%.0s' {1..50})"
echo "Checking Geo database migrations are up-to-date"
echo "${hr}"
cd /srv/gitlab
/srv/gitlab/bin/rake "db:migrate:geo"
echo "${hr}"
