# Docker Hardened Images — CPython FIPS regression fix
# Summary: Restore hashlib usedforsecurity semantics in _hashlib
# Upstream issue: https://github.com/python/cpython/issues/149816
# Regressing backport: https://github.com/python/cpython/pull/160006
# Upstream commit (regressing): https://github.com/python/cpython/commit/3d2f1b2d7aa5
#
# The 3.14 backport of GH-153019 dropped the negation that main and 3.15 apply
# to disable_fips_property(), so usedforsecurity=True digests were fetched with
# "-fips" (non-FIPS provider) and usedforsecurity=False ones with the default
# FIPS properties. Under OpenSSL FIPS mode this let hashlib.md5() succeed.
diff --git a/Modules/_hashopenssl.c b/Modules/_hashopenssl.c
--- a/Modules/_hashopenssl.c
+++ b/Modules/_hashopenssl.c
@@ -421,6 +421,7 @@
     if (fips == -1) {
         goto finally;
     }
+    fips = !fips;
 
     if (entry != NULL) {
         PY_EVP_MD **cached = fips ? &entry->evp : &entry->evp_nosecurity;
