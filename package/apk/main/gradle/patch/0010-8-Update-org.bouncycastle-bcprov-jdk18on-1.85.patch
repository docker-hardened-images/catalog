Subject: Update Bouncy Castle 1.84 to 1.85 for CVE remediation
Origin: DHI-internal CVE remediation
Reference: https://repo.maven.apache.org/maven2/org/bouncycastle/bcprov-jdk18on/1.85/
Description: Gradle 8.14.5 pins Bouncy Castle 1.84 in its distribution dependency platform.
  Bump to 1.85, which fixes CVE-2026-8763 and CVE-2026-13506 without crossing a major
  Bouncy Castle version line.

diff --git a/packaging/distributions-dependencies/build.gradle.kts b/packaging/distributions-dependencies/build.gradle.kts
index e8f4f0c92a5..a1b2c3d4e5f 100644
--- a/packaging/distributions-dependencies/build.gradle.kts
+++ b/packaging/distributions-dependencies/build.gradle.kts
@@ -23,7 +23,7 @@
 // when upgrading ASM.
 val asmVersion = "9.8"
 val awsS3Version = "1.12.780"
-val bouncycastleVersion = "1.84"
+val bouncycastleVersion = "1.85"
 val jacksonVersion = "2.18.9"
 val jaxbVersion = "3.0.0"
 val junit5Version = "5.8.2"
