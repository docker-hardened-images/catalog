Subject: sdk_hard-dereference-tar-gz — add --hard-dereference after ownership arguments

Alpine aports refreshes this patch when dotnet TarGzFileCreateFromDirectory.cs gains
NormalizeSourceBuildOwnership arguments. The stable-branch hunk targets the old one-line
GetDestinationArchive() helper; dotnet v9.0.123 needs --hard-dereference appended after
the ownership prefix instead.

Origin: vendor, https://raw.githubusercontent.com/alpinelinux/aports/f6927022254f79c8925e1f24680f8bbf678c0700/community/dotnet9-runtime/sdk_hard-dereference-tar-gz.patch
Base-Tree: git https://github.com/dotnet/dotnet.git 9f04b57d1366e21b3178648493d6edffeff2216e
Drop-When: dependency aports/community/dotnet9-runtime >= 9.0.22

diff --git a/src/sdk/src/Installer/core-sdk-tasks/TarGzFileCreateFromDirectory.cs.orig b/src/sdk/src/Installer/core-sdk-tasks/TarGzFileCreateFromDirectory.cs
index 7ccc3cc..a61743e 100644
--- a/src/sdk/src/Installer/core-sdk-tasks/TarGzFileCreateFromDirectory.cs.orig
+++ b/src/sdk/src/Installer/core-sdk-tasks/TarGzFileCreateFromDirectory.cs
@@ -118,7 +118,7 @@ private string GetDestinationArchive()
                 ? "--numeric-owner --owner=2001 --group=2001 "
                 : string.Empty;
 
-            return $"{ownershipArguments}-czf {DestinationArchive}";
+            return $"{ownershipArguments}--hard-dereference -czf {DestinationArchive}";
         }
 
         private string GetExcludes()
@@ -132,7 +132,7 @@ private string GetExcludes()
                     excludes += $" --exclude {excludeTaskItem.ItemSpec}";
                 }
             }
-            
+
             return excludes;
         }
 
