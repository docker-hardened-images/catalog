+    # ruby/net-imap@bbd9eb7ecc and @2922a38fda. 0.3 always sends symbols as flags.
+    def validate_flag!(symbol)
+      name = symbol.to_s
+      if name.empty? || !name.ascii_only? || name.match?(/[(){ \x00-\x1f\x7f%*"\\\]]/n)
+        raise DataFormatError, "invalid flag: %p" % [symbol]
+      end
+      name
+    end
+
+    # ruby/net-imap@a3c3d7f5ba. STORE attr is an atom, not raw text.
+    def validate_atom!(str)
+      name = String(str)
+      if name.empty? || !name.ascii_only? || name.match?(/[(){ \x00-\x1f\x7f%*"\\\]]/n)
+        raise DataFormatError, "invalid atom: %p" % [str]
+      end
+      name
+    end
+
+    # ruby/net-imap@7449e180ad. Quoted text cannot carry NULL, CR, or LF.
+    def reject_non_literal_bytes!(str)
+      str = String(str)
+      if str.include?("\0") || /[\r\n]/.match?(str)
+        raise DataFormatError, "NULL, CR, and LF must be literal encoded"
+      end
+      str
+    end
+
     class RawData # :nodoc:
       def send_data(imap, tag)
         imap.__send__(:put_string, @data)
       end

+      # ruby/net-imap@6dd110bfda and @892da94f5c, adapted to 0.3's single string.
+      # Synchronizing literals stay allowed. A non-synchronizing "{n+}" marker
+      # is rejected: 0.3 never emits those, and a raw argument must not smuggle one.
       def validate
+        rest = String(@data).b
+        while rest.match(/(~)?\{(0|[1-9]\d*)(\+)?}\r\n/n)
+          text, plus, bytesize, rest = $`, $3, Integer($2, 10), $'
+          if plus
+            raise DataFormatError, "RawData cannot contain a non-synchronizing literal"
+          end
+          reject_non_literal_text!(text)
+          if rest.bytesize < bytesize
+            raise DataFormatError, "Too few bytes in string for literal, " \
+              "expected: %s, remaining: %s" % [bytesize, rest.bytesize]
+          end
+          rest = rest.byteslice(bytesize, rest.bytesize - bytesize)
+        end
+        reject_non_literal_text!(rest)
+        if rest.rindex(/\{\d+\+?}\z/n)
+          raise DataFormatError, "RawData cannot end with literal continuation"
+        end
+      end
+
+      def reject_non_literal_text!(text)
+        return if text.nil? || text.empty?
+        sample = text.dup
+        unless sample.encoding == Encoding::US_ASCII || sample.encoding == Encoding::UTF_8
+          sample.force_encoding(sample.ascii_only? ? Encoding::US_ASCII : Encoding::UTF_8)
+        end
+        if !sample.valid_encoding?
+          raise DataFormatError, "invalid UTF-8 must be literal encoded"
+        elsif sample.include?("\0")
+          raise DataFormatError, "NULL byte must be binary literal encoded"
+        elsif /[\r\n]/.match?(sample)
+          raise DataFormatError, "CR and LF bytes must be literal encoded"
+        end
       end

       private
@@ -148,12 +213,17 @@ module Net
       end

       def validate
+        str = String(@data)
+        if str.include?("\0") || /[\r\n]/.match?(str)
+          raise DataFormatError, "NULL, CR, and LF must be literal encoded"
+        end
       end

       private

       def initialize(data)
         @data = data
+        validate
       end
     end

