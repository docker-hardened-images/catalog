Subject: APKBUILD: register cryptsetup 2.8.6 jq compatibility patches
Origin: DHI-internal (Alpine package recipe integration)
Description: Patched jq rejects the trailing NUL bytes in cryptsetup 2.8.6's
 generated LUKS2 JSON test fixtures. Register the two upstream test-harness
 fixes and the DHI adaptation in APKBUILD so abuild verifies their checksums,
 applies them during prepare(), and retains the complete check() test suite.
 Exact APKBUILD context intentionally fails closed if Alpine changes its source
 block, preventing an unpatched package from building silently.
Upstream source:
 https://github.com/mbroz/cryptsetup/commit/fe0afb9046e6cd3ad5bb53f091fdabb4d2276de3
 https://github.com/mbroz/cryptsetup/commit/6298269486354834d4037ba294c91452dec4c2f5
Base tree:
 Package: Alpine aports main/cryptsetup
 Commit: https://github.com/alpinelinux/aports/tree/d2f0440960e65952ee22c6b840faecb14d9f0173/main/cryptsetup
 File: APKBUILD
Files: APKBUILD
Forwarded: not-needed (DHI packaging integration only)

diff --git a/APKBUILD b/APKBUILD
--- a/APKBUILD
+++ b/APKBUILD
@@ -19,6 +19,9 @@ makedepends="$makedepends_build $makedepends_host"
 checkdepends="device-mapper which sharutils"
 subpackages="$pkgname-dev $pkgname-doc $pkgname-libs $pkgname-openrc"
-source="https://www.kernel.org/pub/linux/utils/cryptsetup/v${pkgver%.*}/cryptsetup-$pkgver.tar.gz
+source="fe0afb9046e6cd3ad5bb53f091fdabb4d2276de3.patch
+	6298269486354834d4037ba294c91452dec4c2f5.patch
+	dhi-jq-wrapper-tokens-invalid.patch
+	https://www.kernel.org/pub/linux/utils/cryptsetup/v${pkgver%.*}/cryptsetup-$pkgver.tar.gz
 	dmcrypt.initd
 	dmcrypt.confd
 	"
