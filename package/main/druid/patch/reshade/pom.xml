<?xml version="1.0" encoding="UTF-8"?>
<!--
  Relocates fixed releases of libraries that Druid ships only inside shaded
  third-party jars, into the same package prefixes those jars use, so the
  class bytecode moves with the file paths. Each execution writes one
  classifier jar; reshade-shaded-jars.sh swaps its trees into the shipped jars.
  None of these jars is shipped as-is.

  hadoop:    hadoop-client-runtime-3.5.0.jar (org.apache.hadoop.shaded). The
             relocations are copied from that release's own POM, with
             ${shaded.dependency.prefix} written out. hadoop-shaded-guava 1.6.0
             is already relocated (org.apache.hadoop.thirdparty) and is taken
             as-is.
  hadoop336: hadoop-client-runtime-3.3.6.jar, same relocations (identical in
             the 3.3.6 POM), more libraries: 3.3.6 bundles older releases of
             each and a few that 3.5.0 no longer ships.
  iceberg:   iceberg-bundled-guava (org.apache.iceberg.relocated).
  ambari:    ambari-metrics-common-2.7.0.0.0.jar
             (org.apache.ambari.metrics.sink.relocated).
-->
