Source: @PACKAGE_NAME@
Section: database
Priority: optional
Maintainer: Docker Hardened Images <dhi@docker.com>
Build-Depends: debhelper-compat (= 13),
 bison,
 cmake,
 build-essential,
 libaio-dev,
 libcurl4-openssl-dev,
 libicu-dev,
 liblz4-dev,
 libncurses-dev,
 libprotobuf-dev,
 libprotoc-dev,
 libssl-dev,
 libtirpc-dev,
 libzstd-dev,
 pkg-config,
 protobuf-compiler,
 python3,
 zlib1g-dev
Standards-Version: 4.7.0
Homepage: https://www.percona.com/software/mysql-database/percona-server

Package: @PACKAGE_NAME@
Architecture: any
Depends: ${shlibs:Depends}, ${misc:Depends}
Provides: percona-server (= ${binary:Version})
Conflicts: percona-server
Replaces: percona-server
Description: Percona Server for MySQL @MAJOR_MINOR_VERSION@
 Percona Server is a drop-in replacement for MySQL providing enhanced
 performance, scalability, and instrumentation. This package provides the
 Percona Server @MAJOR_MINOR_VERSION@ release line, binary-compatible with
 MySQL @MAJOR_MINOR_VERSION@. This build ships the InnoDB storage engine and
 Percona's server extensions; MyRocks and NDB Cluster are not included.
