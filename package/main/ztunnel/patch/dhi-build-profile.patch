# Subject: Read the build profile from PROFILE instead of the OUT_DIR depth
# Origin: DHI-internal (Rust 1.100 build-dir layout compatibility)
# Base-Tree: git https://github.com/istio/ztunnel.git 82d679bb93131143902a9e7c2650821edc634e14
# Verify: test tests/ztunnel_test.go::TestPackagesRun
# Forwarded: no
# Drop-When: never: upstream derives the profile from the OUT_DIR depth and no release has changed that yet
#
# build.rs takes the fourth path component from the end of OUT_DIR as the profile name,
# which was "release" with the cargo layout target/release/build/<pkg>-<hash>/out. Cargo
# 1.100 added a directory level (build/<pkg>/<hash>/out), so the same component is now
# "build" and ztunnel version prints BuildProfile:"build". Cargo sets PROFILE to "release"
# for release builds and "debug" otherwise, which restores the previous output without
# depending on the build directory layout.

--- a/build.rs
+++ b/build.rs
@@ -80,11 +80,7 @@
     }
 
     // Adoppted from https://github.com/uutils/coreutils/blob/main/src/uu/stdbuf/build.rs
-    let out_dir = env::var("OUT_DIR").unwrap();
-    let profile_name = out_dir
-        .split(std::path::MAIN_SEPARATOR)
-        .nth_back(3)
-        .unwrap();
+    let profile_name = env::var("PROFILE").unwrap();
 
     match Command::new("common/scripts/report_build_info.sh").output() {
         Ok(output) => {
