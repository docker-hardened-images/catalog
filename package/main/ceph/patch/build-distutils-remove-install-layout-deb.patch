Subject: Stop forcing distutils deb install layout in from-source Ceph builds
Origin: DHI-internal (Debian 13 install layout)
Description: Remove --install-layout=deb from Distutils.cmake so Python modules install
 under the /usr/local prefix used by DHI from-source Ceph builds on Debian 13.
Base-Tree: git https://github.com/ceph/ceph 7f793731f1b39eb4f465e960113d2363c311b964 path=cmake/modules/Distutils.cmake
Verify: cmd `patch -p1 --dry-run -i package/main/ceph/patch/build-distutils-remove-install-layout-deb.patch` expect "checking file cmake/modules/Distutils.cmake"
Forwarded: not-needed
Drop-When: never: delete only after upstream no longer forces deb layout on /etc/debian_version

diff --git a/cmake/modules/Distutils.cmake b/cmake/modules/Distutils.cmake
index daaae4b..e606e38 100644
--- a/cmake/modules/Distutils.cmake
+++ b/cmake/modules/Distutils.cmake
@@ -30,9 +30,6 @@ function(distutils_install_module name)
   install(CODE "
     set(options --prefix=${CMAKE_INSTALL_PREFIX})
     if(DEFINED ENV{DESTDIR})
-      if(EXISTS /etc/debian_version)
-        list(APPEND options --install-layout=deb)
-      endif()
       list(APPEND options
         --root=\$ENV{DESTDIR}
         --single-version-externally-managed)
@@ -136,9 +133,6 @@ function(distutils_install_cython_module name)

     set(options --prefix=${CMAKE_INSTALL_PREFIX})
     if(DEFINED ENV{DESTDIR})
-      if(EXISTS /etc/debian_version)
-        list(APPEND options --install-layout=deb)
-      endif()
       list(APPEND options --root=\$ENV{DESTDIR})
     else()
       list(APPEND options --root=/)
