#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_configure:
override_dh_auto_build:
override_dh_auto_test:
override_dh_auto_clean:

# The qdrant binary is built from source in the definition pipeline (with the
# `stacktrace` feature) and staged under payload/. Install it verbatim; do not
# strip, so panic backtraces stay symbolized and no -dbgsym package is emitted.
# dh_shlibdeps still runs to compute ${shlibs:Depends} for the ELF binary.
override_dh_strip:
override_dh_dwz:

override_dh_auto_install:
	mkdir -p debian/tmp
	cp -a payload/usr debian/tmp/usr
