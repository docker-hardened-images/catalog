+// splitTestAddr splits the httptest listener address into host and port so
+// the constructor receives them separately, as production callers do.
+func splitTestAddr(t *testing.T, addr string) (string, string) {
+	t.Helper()
+	host, port, err := net.SplitHostPort(addr)
+	if err != nil {
+		t.Fatalf("SplitHostPort(%q): %v", addr, err)
+	}
+	return host, port
+}
