Migrate hatchet-staticfileserver from legacy chi v1 to chi/v5.

CVE-2025-69725 is fixed in github.com/go-chi/chi/v5 v5.2.4 and later; the
v1 module line has no patched release. hatchet-lite imports staticfileserver,
which is the only active chi consumer in the built binaries.

Advisory: https://github.com/go-chi/chi/security/advisories/GHSA-mqqf-5wvp-8fh8
CVE: https://nvd.nist.gov/vuln/detail/CVE-2025-69725

diff --git a/cmd/hatchet-staticfileserver/staticfileserver/server.go b/cmd/hatchet-staticfileserver/staticfileserver/server.go
--- a/cmd/hatchet-staticfileserver/staticfileserver/server.go
+++ b/cmd/hatchet-staticfileserver/staticfileserver/server.go
@@ -8,8 +8,8 @@ import (
 	"path/filepath"
 	"strings"
 
-	"github.com/go-chi/chi"
-	"github.com/go-chi/chi/middleware"
+	"github.com/go-chi/chi/v5"
+	"github.com/go-chi/chi/v5/middleware"
 )
 
 func NewStaticFileServer(staticFilePath, basePath string) *chi.Mux {
diff --git a/go.mod b/go.mod
--- a/go.mod
+++ b/go.mod
@@ -242,7 +242,7 @@ require (
 	github.com/exaring/otelpgx v0.10.0
 	github.com/fsnotify/fsnotify v1.9.0
 	github.com/getsentry/sentry-go v0.45.1
-	github.com/go-chi/chi v1.5.5
+	github.com/go-chi/chi/v5 v5.3.1
 	github.com/go-playground/validator/v10 v10.30.2
 	github.com/google/cel-go v0.29.0
 	github.com/google/uuid v1.6.0
