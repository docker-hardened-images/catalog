Subject: Fix klog.Fatalf format for subprocess exit code
Description: go test ./cmd/cdi-cloner/... fails vet because Fatalf uses %q with an int exit code; golang.org/x/tools/go/analysis/passes/printf flags the mismatch at build time.
Origin: DHI-internal (cdi-cloner clone-source.go)
Base-Tree: git https://github.com/kubevirt/containerized-data-importer.git c8129be0728afa1a2c49b69b1c0847a42730a732
Adaptation: Use %d for ProcessState.ExitCode() in klog.Fatalf format string.
Verify: cmd `CGO_ENABLED=0 go test ./cmd/cdi-cloner/... -count=1` expect "ok"
Forwarded: not-needed
Drop-When: never: upstream v1.66.1 still uses %q for exit code at cmd/cdi-cloner/clone-source.go

diff --git a/cmd/cdi-cloner/clone-source.go b/cmd/cdi-cloner/clone-source.go
--- a/cmd/cdi-cloner/clone-source.go
+++ b/cmd/cdi-cloner/clone-source.go
@@ -44,7 +44,7 @@ func (er *execReader) Read(p []byte) (int, error) {
 
 	if err := er.cmd.Wait(); err != nil {
 		errBytes, _ := io.ReadAll(er.stderr)
-		klog.Fatalf("Subprocess did not execute successfully, result is: %q\n%s", er.cmd.ProcessState.ExitCode(), string(errBytes))
+		klog.Fatalf("Subprocess did not execute successfully, result is: %d\n%s", er.cmd.ProcessState.ExitCode(), string(errBytes))
 	}
 
 	return n, io.EOF
