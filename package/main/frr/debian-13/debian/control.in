Source: @PKG@
Section: net
Priority: optional
Maintainer: Docker Hardened Images <dhi@docker.com>
Build-Depends: debhelper-compat (= 13),
 autoconf,
 automake,
 bison,
 build-essential,
 flex,
 libc-ares-dev,
 libcap-dev,
 libelf-dev,
 libjson-c-dev,
 libpcre2-dev,
 libprotobuf-c-dev,
 libreadline-dev,
 librtr-dev,
 libsnmp-dev,
 libssl-dev,
 libtool,
 libyang-dev,
 pkg-config,
 protobuf-c-compiler,
 python3,
 python-3.12-dev (= @PYTHON_VERSION@)
Standards-Version: 4.7.0
Homepage: https://frrouting.org

Package: @PKG@
Architecture: any
Depends: libc-ares2,
 libcap2,
 libcap2-bin,
 libelf1t64,
 libjson-c5,
 libpcre2-8-0,
 libpcre2-posix3,
 libreadline8t64,
 librtr0t64,
 libsnmp40t64,
 libssl3t64,
 libyang3,
 python-3.12 (= @PYTHON_VERSION@),
 ${shlibs:Depends},
 ${misc:Depends}
Description: FRRouting (FRR) routing protocol suite
 FRRouting (FRR) is a free and open source Internet routing protocol suite
 for Linux and Unix platforms. It includes protocol daemons for BGP, OSPF,
 IS-IS, RIP, and more.
