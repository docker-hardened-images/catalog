Subject: CVE-2026-31808: stop the file-type ASF parser when a sub-header does not advance

file-type 16.5.4 (required by nestjs-form-data) loops when tokenizer.ignore() does
not advance on a zero-size ASF sub-header. file-type 17+ is ESM-only, so
nestjs-form-data cannot take 21.3.2; the hoisted @nestjs/common copy is bumped to
21.3.2 via yarn resolutions. This carries the position guard from the upstream
commit onto the nestjs-form-data nested copy only.

Advisory: https://github.com/advisories/GHSA-5v7r-6r5c-r473
Upstream source: https://github.com/sindresorhus/file-type/commit/319abf871b50ba2fa221b4a7050059f1ae096f4f
Base tree: Redis Insight api production install of file-type 16.5.4 under nestjs-form-data
Files: node_modules/nestjs-form-data/node_modules/file-type/core.js

--- a/node_modules/nestjs-form-data/node_modules/file-type/core.js
+++ b/node_modules/nestjs-form-data/node_modules/file-type/core.js
@@ -1074,6 +1074,7 @@
 		await tokenizer.ignore(30);
 		// Search for header should be in first 1KB of file.
 		while (tokenizer.position + 24 < tokenizer.fileInfo.size) {
+			const previousPosition = tokenizer.position;
 			const header = await readHeader();
 			let payload = header.size - 24;
 			if (_check(header.id, [0x91, 0x07, 0xDC, 0xB7, 0xB7, 0xA9, 0xCF, 0x11, 0x8E, 0xE6, 0x00, 0xC0, 0x0C, 0x20, 0x53, 0x65])) {
@@ -1101,6 +1102,11 @@
 			}
 
 			await tokenizer.ignore(payload);
+
+			// Safeguard against malformed files: break if the position did not advance.
+			if (tokenizer.position <= previousPosition) {
+				break;
+			}
 		}
 
