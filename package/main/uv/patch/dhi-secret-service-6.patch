Subject: Migrate native keyring support to secret-service 6
Origin: DHI-internal (uv dependency migration)
Description: Keep the native Linux keyring backend with Tokio and RustCrypto while replacing the
 discontinued standalone zbus names and wire crates through secret-service 6 and zbus 6.
Advisory: RUSTSEC-2026-0370
Advisory: RUSTSEC-2026-0371
Advisory: RUSTSEC-2026-0372
Base-Tree: git https://github.com/astral-sh/uv.git e3e7c1eacb980339352a5ad69affcd3b6c206c92
Forwarded: no (downstream dependency migration; not submitted upstream)
Drop-When: dependency secret-service >= 6.0.0
Regenerate: update secret-service to 6.0.0 in the workspace manifest and replace rt-tokio-crypto-rust
 with rt-tokio and crypto-rust in both manifests, then run `git diff -- Cargo.toml crates/uv-keyring/Cargo.toml`
Upstream: https://github.com/open-source-cooperative/secret-service-rs/blob/v6.0.0/README.md#migration-from-version-5

--- a/Cargo.toml
+++ b/Cargo.toml
@@ -291,8 +291,9 @@
 same-file = { version = "1.0.6", default-features = false }
 schemars = { version = "1.0.0", default-features = false, features = ["derive", "std", "url2"] }
 seahash = { version = "4.1.0", default-features = false }
-secret-service = { version = "5.0.0", default-features = false, features = [
-  "rt-tokio-crypto-rust",
+secret-service = { version = "6.0.0", default-features = false, features = [
+  "rt-tokio",
+  "crypto-rust",
 ] }
 shellexpand = { version = "3.1.0", default-features = false, features = [
   "base-0",
--- a/crates/uv-keyring/Cargo.toml
+++ b/crates/uv-keyring/Cargo.toml
@@ -32,7 +32,7 @@
 security-framework = { workspace = true, optional = true }
 
 [target.'cfg(any(target_os = "linux",target_os = "freebsd", target_os = "openbsd"))'.dependencies]
-secret-service = { workspace = true, features = ["rt-tokio-crypto-rust"], optional = true }
+secret-service = { workspace = true, features = ["rt-tokio", "crypto-rust"], optional = true }
 
 [target.'cfg(target_os = "windows")'.dependencies]
 byteorder = { workspace = true, optional = true }
