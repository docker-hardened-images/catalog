#!/usr/bin/make -f

%:
	dh $@

# Compiled from source in the package version file's pipeline (dotnet
# msbuild -t:layout); nothing left to configure, build, test, or clean here.
override_dh_auto_configure:
override_dh_auto_build:
override_dh_auto_test:
override_dh_auto_clean:

# Do not strip the CoreCLR/Node binaries in the built layout.
override_dh_strip:
override_dh_dwz:

# Runtime dependencies are declared explicitly in debian/control. The
# self-contained layout resolves libraries via rpath, which confuses
# dh_shlibdeps.
override_dh_shlibdeps:

override_dh_auto_install:
	mkdir -p debian/tmp/usr/lib/actions-runner
	cp -a _layout/. debian/tmp/usr/lib/actions-runner/
	mkdir -p debian/tmp/usr/bin
	ln -sf ../lib/actions-runner/run.sh debian/tmp/usr/bin/actions-runner
