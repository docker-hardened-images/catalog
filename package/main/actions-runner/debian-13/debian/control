# Runtime deps mirror upstream bin/installdependencies.sh (Debian branch) for
# the actions/runner self-contained .NET 8 build; dh_shlibdeps is skipped
# since these are prebuilt Microsoft/GitHub binaries resolved via rpath.
Depends:
 ${misc:Depends},
 ca-certificates,
