# Bracket IPv6 literals in request_test URLs for Go 1.26+ net/url.
#
# httptest.NewRequest rejects unbracketed IPv6 hosts (panic: invalid port after
# host). RemoteAddr under test is unchanged; only the fixture URL is fixed.
# https://gitlab.com/gitlab-org/gitlab-pages/-/blob/v19.3.1/internal/request/request_test.go
--- a/internal/request/request_test.go
+++ b/internal/request/request_test.go
@@ -118,7 +118,7 @@ func TestGetIPV4orIPV6PrefixWithoutPort(t *testing.T) {
 			expected:   "2001:db8:3333:4444::/64",
 		},
 		"when IPv6 and port component is not provided": {
-			u:          "https://2001:db8:3333:4444:5555:6666:7777:8888",
+			u:          "https://[2001:db8:3333:4444:5555:6666:7777:8888]",
 			remoteAddr: "2001:db8:3333:4444:5555:6666:7777:8888",
 			expected:   "2001:db8:3333:4444::/64",
 		},
