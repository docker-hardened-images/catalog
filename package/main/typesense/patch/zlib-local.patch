Subject: Build zlib from a tracked local tree
Origin: DHI-internal
Description: Replace the WORKSPACE git tag pin for zlib with a
 new_local_repository rooted at /opt/dhi/zlib. The definition downloads
 the madler/zlib archive for ZLIB_COMMIT_SHA and extracts it there, so a
 tracker bump changes the tree without editing this patch.
Upstream: https://github.com/madler/zlib/releases

--- a/WORKSPACE
+++ b/WORKSPACE
@@ -66,11 +66,10 @@
     patches=["//bazel:onnx_ext.patch"],
 )
 
-new_git_repository(
+new_local_repository(
     name = "com_github_madler_zlib",
     build_file = "//bazel:zlib.BUILD",
-    remote = "https://github.com/madler/zlib.git",
-    tag = "v1.2.12",
+    path = "/opt/dhi/zlib",
 )
 
 # new_git_repository(
