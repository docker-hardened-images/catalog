Subject: Build curl from a tracked local tree
Origin: DHI-internal
Description: Replace the WORKSPACE http_archive for curl with a
 new_local_repository rooted at /opt/dhi/curl. The definition downloads
 the curl release tarball for CURL_VERSION and extracts it there, so a
 tracker bump changes the tree without editing this patch.
Upstream: https://github.com/curl/curl/releases

--- a/WORKSPACE
+++ b/WORKSPACE
@@ -212,12 +212,10 @@
     patch_cmds = ["sed -i 's/ -Werror/ -Wno-error=array-bounds/' CMakeLists.txt"],
 )
 
-http_archive(
+new_local_repository(
     name = "curl",
     build_file = "//bazel:curl.BUILD",
-    sha256 = "6147ac0b22f8c11cbd3933d7fec064dee373402c3705193ceb703a5a665f2e0c",
-    strip_prefix = "curl-7.87.0",
-    urls = ["https://github.com/curl/curl/releases/download/curl-7_87_0/curl-7.87.0.zip"],
+    path = "/opt/dhi/curl",
 )
 
 new_git_repository(
