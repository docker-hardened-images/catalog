Subject: Build OpenSSL from a tracked local tree
Origin: DHI-internal
Description: Replace the WORKSPACE http_archive for OpenSSL with a
 new_local_repository rooted at /opt/dhi/openssl. The definition downloads
 openssl-${OPENSSL_VERSION}.tar.gz and extracts it there, so a tracker bump
 changes the tree without editing this patch.
Upstream: https://github.com/openssl/openssl/releases

--- a/WORKSPACE
+++ b/WORKSPACE
@@ -227,12 +227,10 @@
     remote = "https://github.com/h2o/h2o.git",
 )
 
-http_archive(
+new_local_repository(
     name = "openssl",
     build_file = "//bazel:openssl3.BUILD",
-    sha256 = "aa7d8d9bef71ad6525c55ba11e5f4397889ce49c2c9349dcea6d3e4f0b024a7a",
-    strip_prefix = "openssl-3.0.5",
-    urls = ["https://www.openssl.org/source/openssl-3.0.5.tar.gz"],
+    path = "/opt/dhi/openssl",
 )
 
 http_archive(
