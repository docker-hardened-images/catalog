Subject: Point sentencepiece at the declared Bazel protoc
Origin: DHI-internal
Description: sentencepiece's cmake emits a make rule for the imported target
 protobuf::protoc. That target only gets a real location when
 Protobuf_PROTOC_EXECUTABLE exists. The path beside libprotobuf.a is not a
 sentencepiece action input, so a sandboxed rebuild leaves it missing and
 make stops on the colon in the target name. Point the cache entry at
 @com_google_protobuf//:protoc (libprotoc 3.21.5) through $(execpath), and
 declare that binary in data.
Upstream tree: https://github.com/google/sentencepiece/tree/v0.1.98

--- a/bazel/sentencepiece.BUILD
+++ b/bazel/sentencepiece.BUILD
@@ -32,10 +32,16 @@
         'SPM_USE_BUILTIN_PROTOBUF': 'OFF',
         'Protobuf_LIBRARY': '$$BUILD_TMPDIR$$/../../com_google_protobuf/libprotobuf.a',
         'Protobuf_LITE_LIBRARY': '$$BUILD_TMPDIR$$/../../com_google_protobuf/libprotobuf-lite.a',
-        'Protobuf_PROTOC_EXECUTABLE': '$$BUILD_TMPDIR$$/../../com_google_protobuf/protoc',
+        'Protobuf_PROTOC_EXECUTABLE': '$$PROTOC$$',
         'Protobuf_INCLUDE_DIR': '$EXT_BUILD_ROOT/external/com_google_protobuf/src',
         'CMAKE_POLICY_DEFAULT_CMP0111':'OLD'
     },
+    env = {
+        "PROTOC": "$(execpath @com_google_protobuf//:protoc)",
+    },
+    data = [
+        "@com_google_protobuf//:protoc",
+    ],
     deps = [
         "@com_google_protobuf//:protoc",
         "@com_google_protobuf//:protobuf_lite",
