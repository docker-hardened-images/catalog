Subject: Exclude the onnxruntime UnicodePath fixture from the Bazel source glob
Origin: DHI-internal
Description: onnxruntime 1.14.1 ships a non-ASCII test path that Bazel 6
 cannot read as a cmake input. Exclude that test fixture from the source
 glob in bazel/onnxruntime.BUILD. The same file is identical on v29.1 and
 v30.2.
Upstream tree: https://github.com/microsoft/onnxruntime/tree/rel-1.14.1

--- a/bazel/onnxruntime.BUILD
+++ b/bazel/onnxruntime.BUILD
@@ -1,6 +1,6 @@
 filegroup(
     name = "all_srcs",
-    srcs = glob(["**"]),
+    srcs = glob(["**"], exclude = ["winml/test/collateral/models/UnicodePath/**"]),
     visibility = ["//visibility:public"],
 )
 
