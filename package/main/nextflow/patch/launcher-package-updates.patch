Subject: Keep launcher updates under package management
Origin: DHI-internal (package-managed launcher)
Base-Tree: git https://github.com/nextflow-io/nextflow.git 0ad848ef3c3a22824cd9eb2ca14568385867702d
Verify: test tests/nextflow_test.go
Forwarded: not-needed (DHI package payload ownership)
Drop-When: never: only package updates may replace the installed DHI launcher and one-jar

The upstream update commands remove or replace installed files outside the package
manager. Refuse them before any mutation so root users retain the packaged launcher,
one-jar dependency pins and permissions. The same launcher hunk applies to 25 and 26.

--- a/nextflow
+++ b/nextflow
@@ -255,19 +255,9 @@
       echo_yellow "Enabling script debugging - continue the execution launching the remote VM debugger in your favourite IDE using port $NXF_REMOTE_DEBUG_PORT"
       remote_debug=1
       ;;
-    -download)
+    -download|-self-update|self-update)
       if [[ ! "$cmd" ]]; then
-      rm -rf "$NXF_DIST/$NXF_VER" || exit $?
-      bash "$0" -version || exit $?
-      exit 0
-      fi
-      ;;
-    -self-update|self-update)
-      if [[ ! "$cmd" ]]; then
-      [[ -z $NXF_EDGE && $NXF_VER = *-edge ]] && NXF_EDGE=1
-      unset NXF_VER
-      install "$0" update
-      exit 0
+      die "DHI package-managed Nextflow: $1 is disabled; update the nextflow package instead."
       fi
       ;;
     *)
