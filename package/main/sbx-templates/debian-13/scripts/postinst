#!/bin/sh
set -e

if command -v groupadd >/dev/null 2>&1 && command -v useradd >/dev/null 2>&1; then
  if ! getent group agent >/dev/null 2>&1; then
    groupadd --gid 1000 agent
  fi

  if ! getent passwd agent >/dev/null 2>&1; then
    useradd --uid 1000 --gid 1000 --home-dir /home/agent --shell /bin/bash agent
  fi

  if [ -d /usr/share/sbx-templates/home/agent ]; then
    mkdir -p /home/agent
    cp -a /usr/share/sbx-templates/home/agent/. /home/agent/
    chown -R agent:agent /home/agent
  fi

  if [ -f /etc/sandbox-persistent.sh ]; then
    chown agent:agent /etc/sandbox-persistent.sh
  fi
fi
