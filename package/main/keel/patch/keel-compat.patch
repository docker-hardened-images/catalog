@@ -0,0 +1,91 @@
+package slack
+
+import (
+	"bytes"
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/slack-go/slack"
+	"github.com/slack-go/slack/socketmode"
+)
+
+// TestRespondLongReplyUploadsByteLength drives Respond down the file-upload
+// branch against a stub Slack Web API. The reply is over 3000 bytes and holds
+// multibyte UTF-8, so the upload must declare its byte length. slack-go rejects
+// a zero length before any request is sent, and this test fails on that.
+func TestRespondLongReplyUploadsByteLength(t *testing.T) {
+	const channel = "C0KEELTEST"
+
+	text := strings.Repeat("keel réponse 世界 🚀\n", 200)
+	if len(text) < 3000 || len(text) == len([]rune(text)) {
+		t.Fatalf("test reply must exceed 3000 bytes and hold multibyte runes: %d bytes, %d runes",
+			len(text), len([]rune(text)))
+	}
+
+	var (
+		mu          sync.Mutex
+		steps       []string
+		declared    string
+		uploaded    []byte
+		completedOn string
+	)
+
+	var srv *httptest.Server
+	srv = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		mu.Lock()
+		defer mu.Unlock()
+
+		steps = append(steps, r.URL.Path)
+		switch r.URL.Path {
+		case "/files.getUploadURLExternal":
+			_ = r.ParseForm()
+			declared = r.PostForm.Get("length")
+			_ = json.NewEncoder(w).Encode(map[string]any{
+				"ok":         true,
+				"upload_url": srv.URL + "/upload",
+				"file_id":    "F0KEELTEST",
+			})
+		case "/upload":
+			uploaded, _ = io.ReadAll(r.Body)
+			w.WriteHeader(http.StatusOK)
+		case "/files.completeUploadExternal":
+			_ = r.ParseForm()
+			completedOn = r.PostForm.Get("channel_id")
+			_ = json.NewEncoder(w).Encode(map[string]any{
+				"ok":    true,
+				"files": []map[string]string{{"id": "F0KEELTEST"}},
+			})
+		default:
+			http.NotFound(w, r)
+		}
+	}))
+	defer srv.Close()
+
+	api := slack.New("xoxb-test", slack.OptionAPIURL(srv.URL+"/"))
+	b := &Bot{slackSocket: socketmode.New(api)}
+
+	b.Respond(text, channel)
+
+	mu.Lock()
+	defer mu.Unlock()
+
+	wantSteps := []string{"/files.getUploadURLExternal", "/upload", "/files.completeUploadExternal"}
+	if strings.Join(steps, " ") != strings.Join(wantSteps, " ") {
+		t.Fatalf("long reply must run all three upload steps, got %v", steps)
+	}
+	if want := strconv.Itoa(len(text)); declared != want {
+		t.Errorf("upload must declare the reply's byte length %s, got %q", want, declared)
+	}
+	if !bytes.Contains(uploaded, []byte(text)) {
+		t.Errorf("uploaded body must carry the multibyte reply unchanged")
+	}
+	if completedOn != channel {
+		t.Errorf("upload must share to channel %s, got %q", channel, completedOn)
+	}
+}
