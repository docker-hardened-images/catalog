Subject: Use the named minimatch export in the Argo CD UI
Origin: DHI-internal (UI dependency compatibility)
Base-Tree: git https://github.com/argoproj/argo-cd.git 6d732962f61a99c2a0f221fd26b9aac7c83bcf18
Verify: cmd `pnpm exec jest --runInBand --coverage=false --runTestsByPath src/app/applications/components/resource-icon.test.tsx` expect "PASS"
Forwarded: not-needed (DHI overrides the upstream minimatch dependency)
Drop-When: never: required while upstream uses callable namespace imports with the DHI minimatch override

The DHI minimatch override exports an object containing a named minimatch
function. Namespace imports remain objects in the production bundle and fail
when rendering resource icons, filtering applications, or selecting extensions.
Use the named function while retaining the dependency override.

--- a/ui/src/app/applications/components/resource-icon.tsx
+++ b/ui/src/app/applications/components/resource-icon.tsx
@@ -3,3 +3,3 @@
 import {resourceIconGroups as resourceCustomizations} from './resource-customizations';
-import * as minimatch from 'minimatch';
+import {minimatch} from 'minimatch';
 
--- a/ui/src/app/applications/components/applications-list/applications-filter.tsx
+++ b/ui/src/app/applications/components/applications-list/applications-filter.tsx
@@ -1,3 +1,3 @@
 import {useData, Checkbox} from 'argo-ui/v2';
-import * as minimatch from 'minimatch';
+import {minimatch} from 'minimatch';
 import * as React from 'react';
--- a/ui/src/app/shared/services/extensions-service.ts
+++ b/ui/src/app/shared/services/extensions-service.ts
@@ -1,3 +1,3 @@
 import * as React from 'react';
-import * as minimatch from 'minimatch';
+import {minimatch} from 'minimatch';
 
