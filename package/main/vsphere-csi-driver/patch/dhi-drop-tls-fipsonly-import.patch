# DHI packaging: drop the blank crypto/tls/fipsonly import from the syncer.
#
# Provenance: upstream builds the 3.7 syncer with GOEXPERIMENT=boringcrypto
# (images/syncer/Dockerfile at v3.7.3), and crypto/tls/fipsonly only compiles
# under that experiment. DHI builds use the Go native FIPS 140-3 module
# (GOFIPS140 via go/build), which enforces approved crypto at runtime and is
# mutually exclusive with boringcrypto, so the import cannot compile here.
# The import's only effect is an init() that restricts process-wide TLS
# defaults; the native module provides that posture on the -fips variants.
# https://github.com/kubernetes-sigs/vsphere-csi-driver/blob/v3.7.3/images/syncer/Dockerfile
--- a/pkg/syncer/admissionhandler/cnscsi_admissionhandler.go
+++ b/pkg/syncer/admissionhandler/cnscsi_admissionhandler.go
@@ -3,8 +3,6 @@
 import (
 	"context"
 	"crypto/tls"
-
-	_ "crypto/tls/fipsonly"
 	"crypto/x509"
 	"encoding/json"
 	"fmt"
