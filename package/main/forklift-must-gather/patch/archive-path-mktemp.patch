Stage the gather archive in a temp directory instead of /must-gather-archive.
The gather and targeted scripts assemble the tarball in a hardcoded directory
under / and remove it afterwards; as a nonroot user the removal always fails
with permission denied because unlinking from / needs write access on /, and
the fix is upstreamable to the collection scripts:
https://github.com/kubev2v/forklift-must-gather/blob/e8dadb705f0cd91977ae0e9ca69fa821e82a1dca/collection-scripts/gather

diff --git a/collection-scripts/gather b/collection-scripts/gather
index 44dd42b..92fb011 100644
--- a/collection-scripts/gather
+++ b/collection-scripts/gather
@@ -20,7 +20,7 @@ done
 
 # Tar all must-gather artifacts for faster transmission 
 echo "Tarring must-gather artifacts..."
-archive_path="/must-gather-archive"
+archive_path="$(mktemp -d)"
 mkdir -p ${archive_path}
 tar -zcf ${archive_path}/must-gather.tar.gz /must-gather/
 rm -rf /must-gather/*
diff --git a/collection-scripts/targeted b/collection-scripts/targeted
index de7fcbf..d4c9bf3 100644
--- a/collection-scripts/targeted
+++ b/collection-scripts/targeted
@@ -28,7 +28,7 @@ find /must-gather -type d -empty -print -delete
 
 # Tar all must-gather artifacts for faster transmission 
 echo "Tarring must-gather artifacts..."
-archive_path="/must-gather-archive"
+archive_path="$(mktemp -d)"
 mkdir -p ${archive_path}
 tar -zcf ${archive_path}/must-gather.tar.gz /must-gather/
 rm -rf /must-gather/*
