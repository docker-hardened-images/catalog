# Subject: Restore util.log so statsd starts on Node.js 24
# Origin: DHI-internal (Node.js 24 compatibility shim)
# Base-Tree: git https://github.com/statsd/statsd.git 0e20be57d4918dadf5b5fad61b5c61ef382f8860
# Verify: test tests/statsd_test.go::TestStatsdDEB
# Forwarded: no
# Drop-When: upstream >= 0.10.3 (only once that release stops calling util.log)
#
# statsd v0.10.2 calls util.log from lib/config.js, lib/logger.js, lib/process_mgmt.js,
# stats.js and proxy.js. Node.js 24 removed util.log (DEP0059), so stats.js exits with
# "TypeError: util.log is not a function" before it listens. This patch adds
# dhi-util-log.js, which defines util.log only when it is missing, and requires it
# at the top of each of those five files.
# https://github.com/nodejs/node/blob/v24.0.0/doc/api/deprecations.md#dep0059-utillog

--- a/dhi-util-log.js
+++ b/dhi-util-log.js
@@ -0,0 +1,12 @@
+'use strict';
+const util = require('util');
+if (typeof util.log !== 'function') {
+  util.log = function log(...args) {
+    const d = new Date();
+    const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
+    const pad = (n) => String(n).padStart(2, '0');
+    const stamp = d.getDate() + ' ' + months[d.getMonth()] + ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());
+    process.stdout.write(stamp + ' - ' + args.map((part) => String(part)).join(' ') + '\n');
+  };
+}
+module.exports = util;
--- a/lib/config.js
+++ b/lib/config.js
@@ -1,3 +1,4 @@
+require('../dhi-util-log.js');
 /*jshint node:true, laxcomma:true */
 
 const fs  = require('fs')
--- a/lib/logger.js
+++ b/lib/logger.js
@@ -1,3 +1,4 @@
+require('../dhi-util-log.js');
 /*jshint node:true, laxcomma:true */
 
 const Logger = function (config) {
--- a/lib/process_mgmt.js
+++ b/lib/process_mgmt.js
@@ -1,3 +1,4 @@
+require('../dhi-util-log.js');
 const util = require('util');
 
 let conf;
--- a/proxy.js
+++ b/proxy.js
@@ -1,3 +1,4 @@
+require('./dhi-util-log.js');
 /*jshint node:true, laxcomma:true */
 
 var dgram    = require('dgram')
--- a/stats.js
+++ b/stats.js
@@ -1,3 +1,4 @@
+require('./dhi-util-log.js');
 /*jshint node:true, laxcomma:true */
 
 const util = require('util');
