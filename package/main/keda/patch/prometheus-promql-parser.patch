Subject: Adapt the KEDA metrics scaler to the Prometheus parser API
Origin: upstream, https://github.com/kedacore/keda/commit/c28ee2c95ac799a18fb84b688fa00030bc026354
Base-Tree: git https://github.com/kedacore/keda.git 68a5b5028f35b22d50597c69819ab32c4e92f21a

Prometheus v0.311 removed the package-level ParseMetricSelector helper.
Use the parser instance API from the upstream KEDA change on the 2.20 source.

diff --git a/pkg/scalers/metrics_api_scaler.go b/pkg/scalers/metrics_api_scaler.go
--- a/pkg/scalers/metrics_api_scaler.go
+++ b/pkg/scalers/metrics_api_scaler.go
@@ -84,6 +84,10 @@ const (
 	MinAggregationType     AggregationType = "min"
 )
 
+var (
+	promQLParser parser.Parser = parser.NewParser(parser.Options{})
+)
+
 // NewMetricsAPIScaler creates a new HTTP scaler
 func NewMetricsAPIScaler(config *scalersconfig.ScalerConfig, kubeClient client.Client) (Scaler, error) {
 	metricType, err := GetMetricTargetType(config)
@@ -156,7 +160,7 @@ func GetValueFromResponse(body []byte, valueLocation string, format APIFormat) (
 
 // getValueFromPrometheusResponse uses provided valueLocation to access the numeric value in provided body
 func getValueFromPrometheusResponse(body []byte, valueLocation string) (float64, error) {
-	matchers, err := parser.ParseMetricSelector(valueLocation)
+	matchers, err := promQLParser.ParseMetricSelector(valueLocation)
 	if err != nil {
 		return 0, err
 	}
