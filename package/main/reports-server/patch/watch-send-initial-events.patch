diff --git a/pkg/api/watch_initial_events.go b/pkg/api/watch_initial_events.go
new file mode 100644
index 0000000..5a91658
--- /dev/null
+++ b/pkg/api/watch_initial_events.go
@@ -0,0 +1,50 @@
+package api
+
+import (
+	"strconv"
+
+	metainternalversion "k8s.io/apimachinery/pkg/apis/meta/internalversion"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/apimachinery/pkg/watch"
+)
+
+func sendInitialEvents(options *metainternalversion.ListOptions) bool {
+	return options != nil && options.SendInitialEvents != nil && *options.SendInitialEvents
+}
+
+func maxResourceVersion(current, candidate string) (string, error) {
+	if candidate == "" {
+		return current, nil
+	}
+	currentValue, err := strconv.ParseUint(current, 10, 64)
+	if err != nil {
+		return "", err
+	}
+	candidateValue, err := strconv.ParseUint(candidate, 10, 64)
+	if err != nil {
+		return "", err
+	}
+	if candidateValue > currentValue {
+		return candidate, nil
+	}
+	return current, nil
+}
+
+// initialEventsEndBookmark returns a BOOKMARK event annotated so client-go
+// WatchList (k8s 1.31+) can finish its initial-events sync.
+func initialEventsEndBookmark(obj metav1.Object) watch.Event {
+	if obj.GetResourceVersion() == "" {
+		obj.SetResourceVersion("1")
+	}
+	ann := obj.GetAnnotations()
+	if ann == nil {
+		ann = map[string]string{}
+	}
+	ann[metav1.InitialEventsAnnotationKey] = "true"
+	obj.SetAnnotations(ann)
+	return watch.Event{
+		Type:   watch.Bookmark,
+		Object: obj.(runtime.Object),
+	}
+}
diff --git a/pkg/api/watch_initial_events_test.go b/pkg/api/watch_initial_events_test.go
new file mode 100644
index 0000000..8149d72
--- /dev/null
+++ b/pkg/api/watch_initial_events_test.go
@@ -0,0 +1,115 @@
+package api
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/kyverno/reports-server/pkg/storage/inmemory"
+	metainternalversion "k8s.io/apimachinery/pkg/apis/meta/internalversion"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/labels"
+	"k8s.io/apimachinery/pkg/watch"
+	genericapirequest "k8s.io/apiserver/pkg/endpoints/request"
+	openreportsv1alpha1 "openreports.io/apis/openreports.io/v1alpha1"
+)
+
+func TestReportWatchSendsInitialEventsAndBookmark(t *testing.T) {
+	ctx := genericapirequest.WithNamespace(context.Background(), "default")
+	storage := inmemory.New()
+	reports := storage.Reports()
+
+	for _, report := range []*openreportsv1alpha1.Report{
+		{
+			ObjectMeta: metav1.ObjectMeta{
+				Name:            "newer",
+				Namespace:       "default",
+				ResourceVersion: "19",
+				Labels:          map[string]string{"include": "true"},
+			},
+		},
+		{
+			ObjectMeta: metav1.ObjectMeta{
+				Name:            "older",
+				Namespace:       "default",
+				ResourceVersion: "5",
+				Labels:          map[string]string{"include": "true"},
+			},
+		},
+		{
+			ObjectMeta: metav1.ObjectMeta{
+				Name:            "filtered",
+				Namespace:       "default",
+				ResourceVersion: "23",
+				Labels:          map[string]string{"include": "false"},
+			},
+		},
+		{
+			ObjectMeta: metav1.ObjectMeta{
+				Name:            "other-namespace",
+				Namespace:       "other",
+				ResourceVersion: "29",
+				Labels:          map[string]string{"include": "true"},
+			},
+		},
+	} {
+		if err := reports.Create(ctx, report); err != nil {
+			t.Fatalf("create report %q: %v", report.Name, err)
+		}
+	}
+
+	store := ReportStore(reports)
+	defer store.Destroy()
+
+	sendInitialEvents := true
+	watcher, err := store.Watch(ctx, &metainternalversion.ListOptions{
+		ResourceVersion:      "0",
+		ResourceVersionMatch: metav1.ResourceVersionMatchNotOlderThan,
+		SendInitialEvents:    &sendInitialEvents,
+		LabelSelector:        labels.SelectorFromSet(labels.Set{"include": "true"}),
+	})
+	if err != nil {
+		t.Fatalf("watch reports: %v", err)
+	}
+	defer watcher.Stop()
+
+	events := make([]watch.Event, 0, 3)
+	for len(events) < cap(events) {
+		select {
+		case event := <-watcher.ResultChan():
+			events = append(events, event)
+		case <-time.After(time.Second):
+			t.Fatalf("timed out after receiving %d events", len(events))
+		}
+	}
+
+	names := map[string]bool{}
+	for i, event := range events[:2] {
+		if event.Type != watch.Added {
+			t.Fatalf("event %d type = %q, want %q", i, event.Type, watch.Added)
+		}
+		report, ok := event.Object.(*openreportsv1alpha1.Report)
+		if !ok {
+			t.Fatalf("event %d object type = %T, want *Report", i, event.Object)
+		}
+		names[report.Name] = true
+	}
+	if !names["older"] || !names["newer"] || len(names) != 2 {
+		t.Fatalf("initial event names = %v, want older and newer", names)
+	}
+
+	bookmark := events[2]
+	if bookmark.Type != watch.Bookmark {
+		t.Fatalf("final event type = %q, want %q", bookmark.Type, watch.Bookmark)
+	}
+	report, ok := bookmark.Object.(*openreportsv1alpha1.Report)
+	if !ok {
+		t.Fatalf("bookmark object type = %T, want *Report", bookmark.Object)
+	}
+	if report.ResourceVersion != "19" {
+		t.Fatalf("bookmark resourceVersion = %q, want maximum initial resourceVersion 19", report.ResourceVersion)
+	}
+	if report.Annotations[metav1.InitialEventsAnnotationKey] != "true" {
+		t.Fatalf("bookmark annotations = %v, want %s=true", report.Annotations, metav1.InitialEventsAnnotationKey)
+	}
+}
