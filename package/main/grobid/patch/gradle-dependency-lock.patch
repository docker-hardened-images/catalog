Subject: Lock Gradle dependency resolution and raise bundled Java libraries

Origin: DHI-internal (reproducible resolution and library raises for the DHI package build)
CVE: CVE-2026-5598
CVE: CVE-2026-102554
Base-Tree: git https://github.com/grobidOrg/grobid.git 523bb8e97f357e93682dc4eaa6d22faa8b5b93de
Regenerate: `gradle dependencies --write-locks --no-daemon` on the GROBID 0.9.1 checkout after editing build.gradle
Verify: cmd `ls /usr/lib/grobid/grobid-service/lib` expect "jackson-databind-2.21.7.jar"
Forwarded: not-needed (upstream resolves dynamic versions at build time; the lockfiles and raises are specific to this package build)
Drop-When: never: dependency locking is how this package keeps Gradle resolution reproducible; the lockfiles and raises are refreshed on each GROBID release rather than removed

Upstream build.gradle resolves several libraries dynamically and pins others at
releases that have since been superseded. This patch enables Gradle dependency
locking for every configuration, adds the generated gradle.lockfile per project
so each build resolves the same artifact set, and raises the Java libraries
GROBID bundles to their current patch releases: Jackson 2.21.7, Jetty 12.1.10,
logback 1.5.35, httpcomponents core 5.4.3 and client 5.6.3, jruby-complete
10.1.2.0 (bundles BouncyCastle 1.85, which closes CVE-2026-5598 in the 9.4
line's 1.83), moshi 1.15.2 (okio-jvm 3.7.0), and guava 33.7.2-jre (closes
CVE-2026-102554 in 33.6.0; error_prone_annotations 2.50.0 and jspecify 1.0.1
follow it).

diff --git a/build.gradle b/build.gradle
index fe54e43..230d362 100644
--- a/build.gradle
+++ b/build.gradle
@@ -85,6 +85,10 @@ tasks.register('collectGitRevision') {
 allprojects {
     apply plugin: 'net.researchgate.release'
 
+    dependencyLocking {
+        lockAllConfigurations()
+    }
+
     group = "org.grobid"
 
     tasks.withType(JavaCompile) {
@@ -221,14 +225,20 @@ subprojects {
         implementation "org.apache.commons:commons-lang3:3.20.0"
         implementation "org.apache.commons:commons-collections4:4.5.0"
         implementation 'org.apache.commons:commons-text:1.15.0'
-        implementation "com.google.guava:guava:33.6.0-jre"
+        implementation "com.google.guava:guava:33.7.2-jre"
         implementation "org.apache.httpcomponents:httpclient:4.5.14"
         implementation "black.ninia:jep:4.3.1"
         implementation 'com.github.pemistahl:lingua:1.2.2'
 
-        implementation "com.fasterxml.jackson.core:jackson-core:2.21.4"
-        implementation "com.fasterxml.jackson.core:jackson-databind:2.21.4"
-        implementation "com.fasterxml.jackson.dataformat:jackson-dataformat-yaml:2.21.4"
+        implementation "com.fasterxml.jackson.core:jackson-core:2.21.7"
+        implementation "com.fasterxml.jackson.core:jackson-databind:2.21.7"
+        implementation "com.fasterxml.jackson.dataformat:jackson-dataformat-yaml:2.21.7"
+
+        // moshi 1.15.2 depends on okio-jvm 3.7.0. moshi 1.13.0 pulled okio 2.10.0.
+        constraints {
+            implementation 'com.squareup.moshi:moshi:1.15.2'
+            implementation 'com.squareup.moshi:moshi-kotlin:1.15.2'
+        }
     }
 
     tasks.register('sourceJar', Jar) {
@@ -290,7 +300,7 @@ project("grobid-core") {
         // slf4j-api 2.0.x, whose ServiceLoader binding (SLF4JServiceProvider) only exists in logback 1.5.x.
         // logback 1.2.x would leave slf4j with no provider (NOP logging) in batch/standalone mode.
         implementation 'org.slf4j:slf4j-api:2.0.17'
-        implementation 'ch.qos.logback:logback-classic:1.5.26'
+        implementation 'ch.qos.logback:logback-classic:1.5.35'
 
         implementation "org.apache.pdfbox:pdfbox:2.0.36"
 
@@ -311,9 +321,8 @@ project("grobid-core") {
         // NOTE: jruby-complete bundles a vulnerable BouncyCastle (CVE-2026-5598) under its gem stdlib,
         // but GROBID only uses jruby for the optional, non-default Pragmatic sentence segmenter, which
         // never invokes Ruby's openssl — so the BC code is never loaded and the CVE is not triggerable.
-        // No released jruby ships a fixed BouncyCastle yet (latest bundles 1.83; the fix needs 1.84), so
-        // we leave it as-is and wait for an upstream jruby release with BouncyCastle >= 1.84.
-        implementation "org.jruby:jruby-complete:9.4.12.1"
+        // jruby-complete 10.1.2.0 bundles BouncyCastle 1.85. The 9.4 line stops at 1.84.
+        implementation "org.jruby:jruby-complete:10.1.2.0"
 
         shadedLib "org.apache.lucene:lucene-analyzers-common:4.5.1"
     }
@@ -434,10 +443,10 @@ project(":grobid-service") {
         implementation 'ru.vyarus:dropwizard-guicey:8.0.2'
 
         // Dropwizard 5.0.1 ships Jetty 12.1.5, but CVE-2026-2332 (HTTP request smuggling) is only fixed
-        // on the 12.1.x line at 12.1.7+. Import the Jetty BOMs at 12.1.9 so every Jetty artifact is
+        // on the 12.1.x line at 12.1.7+. Import the Jetty BOMs at 12.1.10 so every Jetty artifact is
         // forced past the vulnerable version (Gradle picks the higher of the two BOM-managed versions).
-        implementation platform('org.eclipse.jetty:jetty-bom:12.1.9')
-        implementation platform('org.eclipse.jetty.ee10:jetty-ee10-bom:12.1.9')
+        implementation platform('org.eclipse.jetty:jetty-bom:12.1.10')
+        implementation platform('org.eclipse.jetty.ee10:jetty-ee10-bom:12.1.10')
 
         implementation 'io.dropwizard:dropwizard-bom:5.0.1'
         implementation 'io.dropwizard:dropwizard-core:5.0.1'
@@ -462,6 +471,17 @@ project(":grobid-service") {
         // JVM/process exports) is pushed — no second instrumentation with the OpenTelemetry SDK.
         implementation "io.prometheus:prometheus-metrics-exporter-opentelemetry:1.8.0"
         implementation "io.prometheus:prometheus-metrics-simpleclient-bridge:1.8.0"
+
+        // Raise transitive libraries past versions with published fixes.
+        // Jackson, Jetty, and logback are pinned above. httpcomponents 5 and
+        // the Jackson BOM are only requested transitively.
+        constraints {
+            implementation 'com.fasterxml.jackson:jackson-bom:2.21.7'
+            implementation 'org.apache.httpcomponents.client5:httpclient5:5.6.3'
+            implementation 'org.apache.httpcomponents.core5:httpcore5:5.4.3'
+            implementation 'org.apache.httpcomponents.core5:httpcore5-h2:5.4.3'
+            implementation 'ch.qos.logback:logback-core:1.5.35'
+        }
     }
 
     shadowJar {
@@ -523,7 +543,7 @@ project(":grobid-trainer") {
 
         // logs — see grobid-core: slf4j 2.0.x needs logback 1.5.x for its ServiceLoader binding.
         implementation 'org.slf4j:slf4j-api:2.0.17'
-        implementation 'ch.qos.logback:logback-classic:1.5.26'
+        implementation 'ch.qos.logback:logback-classic:1.5.35'
     }
 
     configurations {
