Origin: DHI-internal
Description: Remove Go-native TypeScript compiler packages from the Langfuse 4
 worker production bundle because the worker runtime does not execute them.
Upstream: https://github.com/langfuse/langfuse
Forwarded: not-needed (DHI package minimization)

diff --git a/debian/rules b/debian/rules
--- a/debian/rules
+++ b/debian/rules
@@ -44,0 +45,5 @@ override_dh_auto_install:
+	# @typescript/typescript-* ships a Go-native tsc binary the worker does not
+	# execute at runtime; Scout reports it as pkg:golang/stdlib and golang.org/x/text.
+	find debian/tmp/usr/lib/nodejs/langfuse-worker -type d \
+		\( -path '*/node_modules/@typescript/typescript-*' \) \
+		-prune -exec rm -rf {} +
