#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_configure:
override_dh_auto_build:
override_dh_auto_test:
override_dh_auto_clean:

# cargo already stripped the binary via CARGO_PROFILE_RELEASE_STRIP, so there is
# nothing for dh_strip/dh_dwz to do and no -dbgsym package to emit.
# dh_shlibdeps still runs, resolving ${shlibs:Depends} to libssl3t64 and libc6
# from the linked ELF.
override_dh_strip:
override_dh_dwz:

override_dh_auto_install:
	mkdir -p debian/tmp
	cp -a payload/usr debian/tmp/usr
