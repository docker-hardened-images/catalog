Fix semconv schema URL conflict introduced by bumping the OpenTelemetry
Go SDK to v1.44.0 for CVE-2026-41178 (https://github.com/advisories/GHSA-5wrp-cwcj-q835).

otel/sdk v1.44.0's process resource detector imports
go.opentelemetry.io/otel/semconv/v1.41.0 (see
https://github.com/open-telemetry/opentelemetry-go/blob/v1.44.0/sdk/resource/process.go),
while mcp-grafana still imports semconv/v1.40.0. Mixing schema URLs during
sdkresource.New() makes tracer provider initialization fail with
"conflicting Schema URL". Align the import with the SDK's semconv version,
matching the same fix already applied for other DHI Go application images
(see package/main/descheduler/patch/fix-semconv-schema-url.patch).

diff --git a/tools.go b/tools.go
--- a/tools.go
+++ b/tools.go
@@ -16,7 +16,7 @@
 	"go.opentelemetry.io/otel/attribute"
 	"go.opentelemetry.io/otel/codes"
 	"go.opentelemetry.io/otel/propagation"
-	semconv "go.opentelemetry.io/otel/semconv/v1.40.0"
+	semconv "go.opentelemetry.io/otel/semconv/v1.41.0"
 	"go.opentelemetry.io/otel/trace"
 )
 
diff --git a/cmd/mcp-grafana/main.go b/cmd/mcp-grafana/main.go
--- a/cmd/mcp-grafana/main.go
+++ b/cmd/mcp-grafana/main.go
@@ -21,7 +21,7 @@
 	"github.com/grafana/mcp-grafana/observability"
 	"github.com/grafana/mcp-grafana/tools"
 	"go.opentelemetry.io/contrib/bridges/otelslog"
-	"go.opentelemetry.io/otel/semconv/v1.40.0/mcpconv"
+	"go.opentelemetry.io/otel/semconv/v1.41.0/mcpconv"
 )
 
 func maybeAddTools(s *server.MCPServer, tf func(*server.MCPServer), enabledTools []string, disable bool, category string) {
diff --git a/observability/observability.go b/observability/observability.go
--- a/observability/observability.go
+++ b/observability/observability.go
@@ -29,8 +29,8 @@
 	sdkmetric "go.opentelemetry.io/otel/sdk/metric"
 	sdkresource "go.opentelemetry.io/otel/sdk/resource"
 	sdktrace "go.opentelemetry.io/otel/sdk/trace"
-	semconv "go.opentelemetry.io/otel/semconv/v1.40.0"
-	"go.opentelemetry.io/otel/semconv/v1.40.0/mcpconv"
+	semconv "go.opentelemetry.io/otel/semconv/v1.41.0"
+	"go.opentelemetry.io/otel/semconv/v1.41.0/mcpconv"
 )
 
 var otelErrHandlerOnce sync.Once
