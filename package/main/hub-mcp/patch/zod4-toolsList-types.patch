Subject: Use Zod 4 toJSONSchema in toolsList instead of zod-to-json-schema
Origin: DHI-internal (hub-mcp packaging)
CVE: CVE-2023-54404
Description: Scout requires zod 4.6.6+ for CVE-2023-54404. zod-to-json-schema does not convert Zod 4 schemas; route toolsList through Zod's native toJSONSchema with draft-07 target to preserve MCP tool schemas, and tolerate the checked-in tools list's final newline.
Base-Tree: git https://github.com/docker/hub-mcp.git 68f4c79223f3ac2a5b6732de58ce7ba22aa8f1a8
Verify: cmd `npm run list-tools:check` expect "Tools names are up to date."
Drop-When: never: upstream dockerhub-mcp/v0.19.0 line still depends on zod-to-json-schema for toolsList until a tagged release replaces it
Forwarded: not-needed (DHI CVE remediation on pinned upstream tag)

diff --git a/src/scripts/toolsList.ts b/src/scripts/toolsList.ts
index 3b1d392..7cc6d55 100644
--- a/src/scripts/toolsList.ts
+++ b/src/scripts/toolsList.ts
@@ -19 +19 @@ import { HubMCPServer } from '../server';
-import { zodToJsonSchema } from 'zod-to-json-schema';
+import { toJSONSchema, type ZodType } from 'zod';
@@ -24 +24,3 @@ import { program } from 'commander';
-import { ZodTypeAny } from 'zod';
+function convertMcpZodSchema(schema: unknown): Tool['inputSchema'] {
+    return toJSONSchema(schema as ZodType, { target: 'draft-07' }) as Tool['inputSchema'];
+}
@@ -76,3 +78 @@ function getToolDefinitionList(): { tools: Tool[] } {
-                        ? (zodToJsonSchema(tool.inputSchema as ZodTypeAny, {
-                              strictUnions: true,
-                          }) as Tool['inputSchema'])
+                        ? convertMcpZodSchema(tool.inputSchema)
@@ -84,3 +84,3 @@ function getToolDefinitionList(): { tools: Tool[] } {
-                    toolDefinition.outputSchema = zodToJsonSchema(tool.outputSchema as ZodTypeAny, {
-                        strictUnions: true,
-                    }) as Tool['outputSchema'];
+                    toolDefinition.outputSchema = convertMcpZodSchema(
+                        tool.outputSchema
+                    ) as Tool['outputSchema'];
@@ -103 +103 @@ function loadCurrentToolsNames(): string[] {
-    return toolsList.split('\n').map((line) => line.split('- name: ')[1].replace(/^"|"$/g, ''));
+    return toolsList.trimEnd().split('\n').map((line) => line.split('- name: ')[1].replace(/^"|"$/g, ''));
