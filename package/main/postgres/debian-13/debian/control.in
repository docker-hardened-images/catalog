Source: postgresql-@MAJOR@
Section: database
Priority: optional
Maintainer: Docker Hardened Images <dhi@docker.com>
Build-Depends: debhelper-compat (= 13),
 clang,
 dpkg-dev,
 libicu-dev,
 libkrb5-dev,
 libldap2-dev,
 liblz4-dev,
 libpam0g-dev,
 libperl-dev,
 libreadline-dev,
 libselinux1-dev,
 libssl-dev,
 libxml2-dev,
 libxslt1-dev,
 libzstd-dev,
 llvm-dev,
 lz4,
 mawk,
 perl,
 pkgconf,
 python3-dev,
 tcl-dev,
 uuid-dev,
 zlib1g-dev,
 zstd
Standards-Version: 4.7.0
Homepage: https://www.postgresql.org/

Package: postgresql-@MAJOR@
Architecture: any
Depends: postgresql-client-@MAJOR@,
 tzdata,
 ${misc:Depends},
 ${shlibs:Depends}
Provides: postgresql-contrib-@MAJOR@,
 postgresql-@MAJOR@-jit-llvm (= ${llvm:Version})
Description: The World's Most Advanced Open Source Relational Database
 PostgreSQL server binaries and extensions, without the Debian cluster
 management layer.

Package: postgresql-client-@MAJOR@
Architecture: any
Multi-Arch: foreign
Depends: libpq5 (>= ${source:Upstream-Version}),
 ${misc:Depends},
 ${shlibs:Depends}
Provides: postgresql-client
Replaces: postgresql-@MAJOR@ (<< ${source:Version})
Breaks: postgresql-@MAJOR@ (<< ${source:Version})
Description: front-end programs for PostgreSQL @MAJOR@
 Command-line client programs, such as psql and pg_dump, and the PGXS build
 files for PostgreSQL @MAJOR@.

Package: postgresql-server-dev-@MAJOR@
Architecture: any
Section: libdevel
Depends: clang-${llvm:Version},
 libpq-dev (>= @MAJOR@~~),
 llvm-${llvm:Version}-dev,
 mawk,
 postgresql-client-@MAJOR@,
 ${misc:Depends},
 ${shlibs:Depends}
Description: development files for PostgreSQL @MAJOR@ server-side programming
 Header files and static libraries for building PostgreSQL @MAJOR@ server
 extensions with PGXS.

Package: postgresql-plperl-@MAJOR@
Architecture: any
Depends: perl,
 postgresql-@MAJOR@ (= ${binary:Version}),
 ${misc:Depends},
 ${shlibs:Depends}
Provides: postgresql-plperl
Description: PL/Perl procedural language for PostgreSQL @MAJOR@
 PL/Perl lets you write PostgreSQL functions in Perl.

Package: postgresql-plpython3-@MAJOR@
Architecture: any
Depends: postgresql-@MAJOR@ (= ${binary:Version}),
 ${misc:Depends},
 ${shlibs:Depends}
Provides: postgresql-plpython3
Description: PL/Python 3 procedural language for PostgreSQL @MAJOR@
 PL/Python 3 lets you write PostgreSQL functions in Python 3.

Package: postgresql-pltcl-@MAJOR@
Architecture: any
Depends: libtcl8.6,
 postgresql-@MAJOR@ (= ${binary:Version}),
 ${misc:Depends},
 ${shlibs:Depends}
Provides: postgresql-pltcl
Description: PL/Tcl procedural language for PostgreSQL @MAJOR@
 PL/Tcl lets you write PostgreSQL functions in Tcl.
