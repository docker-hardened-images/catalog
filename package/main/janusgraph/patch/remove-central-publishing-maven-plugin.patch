Origin: DHI-internal (package build compatibility)
Description: Drop Sonatype central-publishing-maven-plugin from janusgraph-release;
 the extension is only for Maven Central uploads and is not resolvable in DHI builds.
Upstream: https://github.com/JanusGraph/janusgraph/blob/v1.2.0/pom.xml
Forwarded: no

diff --git a/pom.xml b/pom.xml
--- a/pom.xml
+++ b/pom.xml
@@ -1737,19 +1737,6 @@
                             </execution>
                         </executions>
                     </plugin>
-                    <plugin>
-                        <groupId>org.sonatype.central</groupId>
-                        <artifactId>central-publishing-maven-plugin</artifactId>
-                        <version>0.11.0</version>
-                        <extensions>true</extensions>
-                        <configuration>
-                            <!-- The server "id" element from settings to use authentication from -->
-                            <publishingServerId>central</publishingServerId>
-                            <autoPublish>${autoPublish}</autoPublish>
-                            <waitUntil>${waitUntil}</waitUntil>
-                            <waitMaxTime>3600</waitMaxTime>
-                        </configuration>
-                    </plugin>
                 </plugins>
             </build>
         </profile>
