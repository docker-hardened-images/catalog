Subject: Configure pnpm workspace linker and dependency overrides
Origin: DHI-internal (DHI build harness)
Description: Set the hoisted node linker and copy imports in the workspace
 file because pnpm rejects these required package-build settings globally.
 Override undici and qs, which 44.190.0 still locks below their fixed releases.
Base-Tree: git https://github.com/renovatebot/renovate.git ec10d676db3337626244323caed7835ef72fcdc1
Verify: cmd `grep -xF -e 'nodeLinker: hoisted' -e '  qs@<6.16.1: 6.16.1' -e '  undici@<8.12.2: 8.12.2' pnpm-workspace.yaml` expect "the linker and both overrides"
Forwarded: not-needed (DHI build configuration and security overrides)
CVE: CVE-2026-109869
CVE: CVE-2026-110816
Drop-When: never: DHI package builds require deterministic hoisted copies; review dependency overrides on version updates

diff --git a/pnpm-workspace.yaml b/pnpm-workspace.yaml
--- a/pnpm-workspace.yaml
+++ b/pnpm-workspace.yaml
@@ -32,6 +32,8 @@
   shell-quote@>=1.8.4 <1.11.0: 1.12.0
   smol-toml@<=1.8.0: 1.9.1
   source-map-js@>=1.0.0 <1.2.2: 1.2.2
+  qs@<6.16.1: 6.16.1
+  undici@<8.12.2: 8.12.2
   vite: 'catalog:'

 ignoredOptionalDependencies:
@@ -70,3 +72,6 @@
   - argparse@3.0.3

 provenance: true
+
+nodeLinker: hoisted
+packageImportMethod: copy
