Subject: Use POSIX = in test expressions so dash can run the deployer

Origin: DHI-internal (POSIX shell compatibility)
Base-Tree: git https://github.com/kubeflow/pipelines 555bfa60a70da88c594960bdacfd78fa7c061043
Verify: cmd `go test ./package/main/kubeflow-pipelines-cache-deployer/tests -run TestClosureRoot -count=1` expect "ok"
Forwarded: no (not proposed upstream yet)
Drop-When: never: keep until upstream deploy-cache-service.sh stops using == inside [ ]

The upstream entrypoint runs the script with /bin/sh, which is busybox ash on
Alpine and accepts == inside [ ]. On Debian /bin/sh is dash, whose test builtin
rejects == with "unexpected operator", so every comparison evaluates false and an
already-installed webhook is deleted and recreated. The three comparisons use the
POSIX = operator, which both shells and bash treat identically.

--- a/backend/src/cache/deployer/deploy-cache-service.sh
+++ b/backend/src/cache/deployer/deploy-cache-service.sh
@@ -91,17 +91,17 @@
     webhook_secret_exists=true
 fi
 
-if [ "$webhook_config_exists" == "true" ] && [ "$webhook_secret_exists" == "true" ]; then
+if [ "$webhook_config_exists" = "true" ] && [ "$webhook_secret_exists" = "true" ]; then
     echo "Webhook config and secret are already installed. Sleeping forever."
     sleep infinity
 fi
 
-if [ "$webhook_config_exists" == "true" ]; then
+if [ "$webhook_config_exists" = "true" ]; then
     echo "Warning: Webhook config exists, but the secret does not exist. Reinstalling."
     kubectl delete mutatingwebhookconfigurations "${MUTATING_WEBHOOK_CONFIGURATION_NAME}" --namespace "${NAMESPACE}"
 fi
 
-if [ "$webhook_secret_exists" == "true" ]; then
+if [ "$webhook_secret_exists" = "true" ]; then
     echo "Warning: Webhook secret exists, but the config does not exist. Reinstalling."
     kubectl delete secrets "${WEBHOOK_SECRET_NAME}" --namespace "${NAMESPACE}"
 fi
