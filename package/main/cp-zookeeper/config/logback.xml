<!--
  Logging configuration for this image. Upstream ZooKeeper's own file is
  https://github.com/apache/zookeeper/blob/release-3.8.6/conf/logback.xml
  Two things differ, both so that the Confluent ZOOKEEPER_LOG4J_* environment
  variables take effect:

  1. The root level reads the zookeeper.root.logger system property, which
     zookeeper-run-class sets from ZOOKEEPER_LOG4J_ROOT_LOGLEVEL. Upstream
     writes <root level="INFO"> as a literal, so no system property can change
     it. The default here is written inline as ${zookeeper.root.logger:-INFO}
     rather than declared in a <property> element, because a <property> of the
     same name would take precedence over the system property:
     https://logback.qos.ch/manual/configuration.html#scopes

  2. There is no ThresholdFilter on the console appender. Upstream's filter
     denies every event below INFO, including events emitted only because
     ZOOKEEPER_LOG4J_LOGGERS raised one logger to DEBUG. Without the filter,
     logger levels alone decide what is printed.

  The encoder pattern is copied unchanged from upstream ZooKeeper. It is not
  the pattern Confluent's cp-zookeeper uses ([%d] %p %m (%c)%n), so log lines
  from this image are formatted like Apache ZooKeeper's, not like Confluent's.
-->
<configuration>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{ISO8601} [myid:%X{myid}] - %-5p [%t:%C{1}@%L] - %m%n</pattern>
    </encoder>
  </appender>

  <root level="${zookeeper.root.logger:-INFO}">
    <appender-ref ref="CONSOLE" />
  </root>
</configuration>
