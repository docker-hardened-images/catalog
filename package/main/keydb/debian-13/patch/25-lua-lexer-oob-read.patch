Lua lexer: fix out-of-bounds read on long-bracket separators (CVE-2025-46819)

The Lua 5.1 lexer counted the '=' characters of a long-bracket
separator ('[==[' / ']==]') in an int and encoded the failure case as
(-count) - 1; a separator longer than INT_MAX wrapped the count and let
read_long_string() compute an out-of-range buffer offset (out-of-bounds
read). luaX_setinput also left ls->t.token uninitialised, so an early
lexer error could format a "near <garbage>" message from stale memory.
skip_sep now returns a size_t (well-formed: count + 2; '[' alone: 1;
unfinished '[=..': 0), read_long_string takes the same size_t, and
ls->t.token is zeroed on setinput.

Tracker: CVE-2025-46819
Upstream patch: https://github.com/redis/redis/commit/ef22554057e50c67d0f8d0ede39483358356321f
Adaptation: deps/lua/src/llex.c in KeyDB v6.3.4 is byte-identical to the Redis 6.2 parent, so the llex.c hunks are carried verbatim. The Tcl regression tests are ported too: tests/support/server.tcl uses $::tags because KeyDB's tags_acceptable has no local 'tags' copy; the "large-memory" gate in tests/test_helper.tcl is inserted after 'set ::dump_logs 0' (KeyDB has no ::singledb line); the new scripting.tcl stanza is appended at the end of the file since KeyDB lacks the lua-enable-deprecated-api stanza used as upstream context.

diff --git a/deps/lua/src/llex.c b/deps/lua/src/llex.c
--- a/deps/lua/src/llex.c
+++ b/deps/lua/src/llex.c
@@ -138,6 +138,7 @@
 
 
 void luaX_setinput (lua_State *L, LexState *ls, ZIO *z, TString *source) {
+  ls->t.token = 0;
   ls->decpoint = '.';
   ls->L = L;
   ls->lookahead.token = TK_EOS;  /* no look-ahead token */
@@ -206,9 +207,13 @@
     trydecpoint(ls, seminfo); /* try to update decimal point separator */
 }
 
-
-static int skip_sep (LexState *ls) {
-  int count = 0;
+/*
+** reads a sequence '[=*[' or ']=*]', leaving the last bracket.
+** If a sequence is well-formed, return its number of '='s + 2; otherwise,
+** return 1 if there is no '='s or 0 otherwise (an unfinished '[==...').
+*/
+static size_t skip_sep (LexState *ls) {
+  size_t count = 0;
   int s = ls->current;
   lua_assert(s == '[' || s == ']');
   save_and_next(ls);
@@ -216,11 +221,13 @@
     save_and_next(ls);
     count++;
   }
-  return (ls->current == s) ? count : (-count) - 1;
+   return (ls->current == s) ? count + 2
+          : (count == 0) ? 1
+          : 0;
 }
 
 
-static void read_long_string (LexState *ls, SemInfo *seminfo, int sep) {
+static void read_long_string (LexState *ls, SemInfo *seminfo, size_t sep) {
   int cont = 0;
   (void)(cont);  /* avoid warnings when `cont' is not used */
   save_and_next(ls);  /* skip 2nd `[' */
@@ -270,8 +277,8 @@
     }
   } endloop:
   if (seminfo)
-    seminfo->ts = luaX_newstring(ls, luaZ_buffer(ls->buff) + (2 + sep),
-                                     luaZ_bufflen(ls->buff) - 2*(2 + sep));
+    seminfo->ts = luaX_newstring(ls, luaZ_buffer(ls->buff) + sep,
+                                     luaZ_bufflen(ls->buff) - 2 * sep);
 }
 
 
@@ -346,9 +353,9 @@
         /* else is a comment */
         next(ls);
         if (ls->current == '[') {
-          int sep = skip_sep(ls);
+          size_t sep = skip_sep(ls);
           luaZ_resetbuffer(ls->buff);  /* `skip_sep' may dirty the buffer */
-          if (sep >= 0) {
+          if (sep >= 2) {
             read_long_string(ls, NULL, sep);  /* long comment */
             luaZ_resetbuffer(ls->buff);
             continue;
@@ -360,13 +367,14 @@
         continue;
       }
       case '[': {
-        int sep = skip_sep(ls);
-        if (sep >= 0) {
+        size_t sep = skip_sep(ls);
+        if (sep >= 2) {
           read_long_string(ls, seminfo, sep);
           return TK_STRING;
         }
-        else if (sep == -1) return '[';
-        else luaX_lexerror(ls, "invalid long string delimiter", TK_STRING);
+        else if (sep == 0)  /* '[=...' missing second bracket */
+          luaX_lexerror(ls, "invalid long string delimiter", TK_STRING);
+        return '[';
       }
       case '=': {
         next(ls);
