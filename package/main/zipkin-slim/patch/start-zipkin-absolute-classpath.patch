Subject: Run start-zipkin from any working directory
Origin: DHI-internal (install layout)
Description: Give both start-zipkin launch lines an absolute class path.
 Upstream's script puts the current directory and relative BOOT-INF paths on the
 Java class path, which works only because upstream's image always runs it from
 WORKDIR /zipkin. The package installs start-zipkin on PATH and the unpacked slim
 jar under /usr/share/zipkin-slim, so both launch lines name that directory.
Base-Tree: git https://github.com/openzipkin/zipkin.git b2b0c98acf20944766bb1365de04b3316da83078
Verify: test tests/zipkin_slim_test.go::TestZipkinSlimDEB
Forwarded: not-needed (upstream's image always runs start-zipkin from WORKDIR /zipkin)
Drop-When: never: the package installs start-zipkin on PATH, outside the unpacked slim jar

--- a/docker/start-zipkin
+++ b/docker/start-zipkin
@@ -24,12 +24,12 @@
 
   # Use main class directly if there are no modules, as it measured 14% faster from JVM running to
   # available verses PropertiesLauncher when using Zipkin was based on Spring Boot 2.1
-  exec java ${JAVA_OPTS} -cp '.:BOOT-INF/lib/*:BOOT-INF/classes' zipkin.server.ZipkinServer "$@"
+  exec java ${JAVA_OPTS} -cp '/usr/share/zipkin-slim:/usr/share/zipkin-slim/BOOT-INF/lib/*:/usr/share/zipkin-slim/BOOT-INF/classes' zipkin.server.ZipkinServer "$@"
 else
   JAVA_OPTS=${JAVA_OPTS:-"-Xms96m -Xmx96m -XX:+ExitOnOutOfMemoryError"}
 
   # Disable Log4j2 JMX extensions when running the full build
-  exec java ${MODULE_OPTS} ${JAVA_OPTS} -cp . \
+  exec java ${MODULE_OPTS} ${JAVA_OPTS} -cp /usr/share/zipkin-slim \
   -Dlog4j2.disable.jmx=true \
   org.springframework.boot.loader.launch.PropertiesLauncher "$@"
 fi
