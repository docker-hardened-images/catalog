Remove btf.FlushKernelSpec calls removed in cilium/ebpf v0.22.0.

The pinned OBI commit calls btf.FlushKernelSpec(), which was removed in
github.com/cilium/ebpf v0.22.0 (CVE-2026-10722 fix). OBI main dropped these
calls when adopting ebpf v0.22.0's btf.Cache API.

diff --git a/.obi-src/pkg/components/ebpf/tracer_linux.go b/.obi-src/pkg/components/ebpf/tracer_linux.go
--- a/.obi-src/pkg/components/ebpf/tracer_linux.go
+++ b/.obi-src/pkg/components/ebpf/tracer_linux.go
@@ -15,7 +15,6 @@ import (
 	"time"
 
 	"github.com/cilium/ebpf"
-	"github.com/cilium/ebpf/btf"
 	"github.com/cilium/ebpf/link"
 
 	"github.com/open-telemetry/opentelemetry-ebpf-instrumentation/pkg/app/request"
@@ -273,7 +272,6 @@ func (pt *ProcessTracer) loadTracers(eventContext *common.EBPFEventContext) err
 
 	pt.Programs = loadedPrograms
 
-	btf.FlushKernelSpec()
 
 	return nil
 }
@@ -386,7 +384,6 @@ func RunUtilityTracer(ctx context.Context, eventContext *common.EBPFEventContex
 
 	go p.Run(ctx)
 
-	btf.FlushKernelSpec()
 
 	return nil
 }
