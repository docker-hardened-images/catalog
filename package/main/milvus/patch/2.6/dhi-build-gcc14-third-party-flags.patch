Build the pinned Conan third-party recipes under Debian 13's gcc 14.

Upstream builds the 2.6 line with gcc 12. gcc 14 turns two warning classes
into errors inside recipes the line pins: rocksdb 6.29.5 and other C++
recipes need <cstdint> force-included, and libunwind 1.7.2's aarch64 sources
trip -Wincompatible-pointer-types in C. scripts/3rdparty_build.sh exports the
compiler flags for every recipe and overwrites whatever the environment set,
so both flags are spliced into those exports.

Upstream script: https://github.com/milvus-io/milvus/blob/v2.6.23/scripts/3rdparty_build.sh
gcc 14 porting notes: https://gcc.gnu.org/gcc-14/porting_to.html

diff --git a/scripts/3rdparty_build.sh b/scripts/3rdparty_build.sh
index a8c0496..2dbf6b2 100644
--- a/scripts/3rdparty_build.sh
+++ b/scripts/3rdparty_build.sh
@@ -126,8 +126,8 @@ unset DYLD_INSERT_LIBRARIES
 
 
 export CONAN_REVISIONS_ENABLED=1
-export CXXFLAGS="-Wno-error=address -Wno-error=deprecated-declarations"
-export CFLAGS="-Wno-error=address -Wno-error=deprecated-declarations"
+export CXXFLAGS="-Wno-error=address -Wno-error=deprecated-declarations -include cstdint"
+export CFLAGS="-Wno-error=address -Wno-error=deprecated-declarations -Wno-error=incompatible-pointer-types"
 
 # Determine the Conan remote URL, using the environment variable if set, otherwise defaulting
 CONAN_ARTIFACTORY_URL="${CONAN_ARTIFACTORY_URL:-https://milvus01.jfrog.io/artifactory/api/conan/default-conan-local}"
