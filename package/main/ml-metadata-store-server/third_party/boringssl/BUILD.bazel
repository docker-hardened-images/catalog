# Stands in for @boringssl so gRPC links the system OpenSSL (libssl3 / libcrypto3).
# Headers come from the toolchain's builtin /usr/include.

cc_library(
    name = "crypto",
    linkopts = ["-lcrypto"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "ssl",
    linkopts = ["-lssl"],
    visibility = ["//visibility:public"],
    deps = [":crypto"],
)
