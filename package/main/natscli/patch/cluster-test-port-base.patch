Subject: Isolate natscli matrix cluster test ports

Origin: DHI-internal (parallel package matrix tests)
Description: Read a positive cluster port base from NATS_CLI_TEST_CLUSTER_PORT_BASE so parallel standard and FIPS test suites do not bind the same JetStream route ports.
Base-Tree: git https://github.com/nats-io/natscli.git 4fcbcbc3450da9446fbc700ff19a1dca137f14cb
Verify: cmd `NATS_CLI_TEST_CLUSTER_PORT_BASE=13000 go test ./nats/... -count=1` expect "ok"
Forwarded: not-needed (the environment variable separates DHI package matrix variants)
Drop-When: never: DHI package matrix variants need separate deterministic JetStream cluster port ranges

Parallel standard and FIPS package builds run the upstream tests concurrently, so each matrix variant needs a distinct deterministic cluster port range.

diff --git a/nats/tests/nats_test.go b/nats/tests/nats_test.go
index 3ebd72f..571b7d0 100644
--- a/nats/tests/nats_test.go
+++ b/nats/tests/nats_test.go
@@ -25,0 +26 @@ import (
+	"strconv"
@@ -277,0 +279,9 @@ func withJSClusterDomain(t *testing.T, domain string, cb func(*testing.T, []*ser
+func clusterPortBase() int {
+	if v := os.Getenv("NATS_CLI_TEST_CLUSTER_PORT_BASE"); v != "" {
+		if base, err := strconv.Atoi(v); err == nil && base > 0 {
+			return base
+		}
+	}
+	return 12000
+}
+
@@ -290,0 +301 @@ func createServersWithCallback(t *testing.T, serverCount int, jsEnabled bool, js
+	base := clusterPortBase()
@@ -292 +303 @@ func createServersWithCallback(t *testing.T, serverCount int, jsEnabled bool, js
-		routes = append(routes, &url.URL{Host: fmt.Sprintf("localhost:%d", 12000+i)})
+		routes = append(routes, &url.URL{Host: fmt.Sprintf("localhost:%d", base+i)})
@@ -317 +328 @@ func createServersWithCallback(t *testing.T, serverCount int, jsEnabled bool, js
-				Port: 12000 + i,
+				Port: base + i,
