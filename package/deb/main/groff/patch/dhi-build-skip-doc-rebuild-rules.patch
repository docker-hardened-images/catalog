DHI build harness: keep upstream prebuilt groff documentation in debian/rules.
Debian groff 1.23.0-9 moves prebuilt doc files aside before texi2dvi rebuilds;
texi2dvi fails in the hermetic builder. Copy orig-tarball docs into the build
tree instead of forcing a rebuild.
Upstream packaging: https://salsa.debian.org/debian/groff

diff --git a/debian/rules b/debian/rules
--- a/debian/rules
+++ b/debian/rules
@@ -72,11 +72,11 @@
 endif
 
 override_dh_auto_build:
-	# Always rebuild documentation from source.
-	mkdir -p debian/doc-save
-	find doc \( -name \*.dvi -or -name \*.info -or -name \*.pdf \) \
-		-exec mv -f -t debian/doc-save '{}' +
+	mkdir -p debian/build/doc
+	cp -a doc/groff.dvi doc/groff.info doc/groff.pdf doc/groff.html doc/groff.txt debian/build/doc/
 ifneq ($(DEB_BUILD_GNU_TYPE),$(DEB_HOST_GNU_TYPE))
+	mkdir -p debian/build-native/doc
+	cp -a doc/groff.dvi doc/groff.info doc/groff.pdf doc/groff.html doc/groff.txt debian/build-native/doc/
 	dh_auto_build --builddirectory=debian/build-native -- \
 		extratmacdirs=/usr/share/groff/tmac \
 		docdir=\$${prefix}/share/doc/groff-base
