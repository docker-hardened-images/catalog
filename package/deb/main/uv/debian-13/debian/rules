#!/usr/bin/make -f

# Host triple from the installed rustc. DHI's rustc-${major.minor} packages do
# not ship Debian's /usr/share/rustc/architecture.mk.
DEB_HOST_RUST_TYPE ?= $(shell rustc -vV | sed -n 's/^host: //p')

export CARGO_HOME=$(CURDIR)/debian/cargo-home
export CARGO_TARGET_DIR=$(CURDIR)/target
export CARGO_BUILD_TARGET=$(DEB_HOST_RUST_TYPE)

include /usr/share/dpkg/architecture.mk

# jemalloc fixes its page size at build time; 16 KiB pages also run on 4 KiB
# kernels, the reverse aborts with "Unsupported system page size".
ifeq ($(DEB_HOST_ARCH),arm64)
export JEMALLOC_SYS_WITH_LG_PAGE=16
endif

%:
	dh $@ -v

override_dh_auto_configure:

override_dh_auto_build:

override_dh_auto_test:

override_dh_auto_install:
	cargo auditable install --locked --root debian/uv/usr --path crates/uv

execute_before_dh_installman:
	help2man --no-info \
		debian/uv/usr/bin/uv > debian/uv.1
	help2man --no-info \
		debian/uv/usr/bin/uvx > debian/uvx.1

override_dh_auto_clean:
	rm -rf $(CARGO_TARGET_DIR)
	rm -rf $(CARGO_HOME)
