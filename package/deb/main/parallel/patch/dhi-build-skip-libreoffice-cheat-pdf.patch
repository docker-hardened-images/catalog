# DHI-only patch (not upstream). Targets GNU parallel 20240222+ds:
#   https://www.gnu.org/software/parallel/
#   https://sources.debian.org/src/parallel/20240222+ds-2/
#
# LibreOffice headless PDF conversion of parallel_cheat_bw.fodt fails in the
# offline DHI build sandbox (com.sun.star.uno.RuntimeException). Upstream
# ships only the .fodt source, not a prebuilt parallel_cheat_bw.pdf, so the
# Makefile fallback cannot recover. Touch the PDF target so install-docDATA
# succeeds; the cheat sheet is optional documentation for our package use case.
--- a/src/Makefile.am
+++ b/src/Makefile.am
@@ -393,8 +393,7 @@ parsort.pdf: parsort
 	|| echo "Warning: pod2pdf not found. Using old parsort.pdf"
 
 parallel_cheat_bw.pdf: parallel_cheat_bw.fodt
-	libreoffice --headless --convert-to pdf parallel_cheat_bw.fodt \
-	|| echo "Warning: libreoffice failed. Using old parallel_cheat_bw.pdf"
+	touch $@
 
 parallel_options_map.pdf: parallel.pod pod2graph
 	./pod2graph parallel.pod > parallel_options_map.pdf \
