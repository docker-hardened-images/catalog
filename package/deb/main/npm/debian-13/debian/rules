#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_configure:
override_dh_auto_build:
	# Extract the npm registry tarball
	mkdir -p npm-extract
	tar -xzf $(wildcard $(CURDIR)/../npm-*.tgz) -C npm-extract --strip-components=1

override_dh_auto_install:
	# Stage into FHS paths
	mkdir -p debian/tmp/usr/lib/nodejs/npm
	cp -R npm-extract/* debian/tmp/usr/lib/nodejs/npm/
	# Bump picomatch (CVE-2026-33671, CVE-2026-33672)
	$(CURDIR)/debian/vendor-replace.sh picomatch 4.0.4 \
		debian/tmp/usr/lib/nodejs/npm/node_modules/tinyglobby/node_modules
	# Bump brace-expansion (CVE-2026-102276, CVE-2026-102277, CVE-2026-102278)
	$(CURDIR)/debian/vendor-replace.sh brace-expansion 5.0.12 \
		debian/tmp/usr/lib/nodejs/npm/node_modules
	# Bump http-cache-semantics (CVE-2026-93748)
	$(CURDIR)/debian/vendor-replace.sh http-cache-semantics 4.3.0 \
		debian/tmp/usr/lib/nodejs/npm/node_modules
	# Bump tar (GHSA-r292-9mhp-454m)
	$(CURDIR)/debian/vendor-replace.sh tar 7.5.21 \
		debian/tmp/usr/lib/nodejs/npm/node_modules
	# Bump undici (CVE-2026-19534, CVE-2026-85024, CVE-2026-18540, CVE-2026-87018, CVE-2026-109869, CVE-2026-109383, CVE-2026-109932, CVE-2026-109924)
	$(CURDIR)/debian/vendor-replace.sh undici 6.29.1 \
		debian/tmp/usr/lib/nodejs/npm/node_modules
	# Bump ip-address (CVE-2026-101910, CVE-2026-101911, CVE-2026-101912, CVE-2026-101913, CVE-2026-111997)
	$(CURDIR)/debian/vendor-replace.sh ip-address 10.7.6 \
		debian/tmp/usr/lib/nodejs/npm/node_modules
	# Bump postcss-selector-parser (CVE-2026-104844)
	$(CURDIR)/debian/vendor-replace.sh postcss-selector-parser 7.1.6 \
		debian/tmp/usr/lib/nodejs/npm/node_modules
	# Clean stray files
	rm -rf debian/tmp/usr/lib/nodejs/npm/node_modules/socks/.claude

override_dh_fixperms:
	dh_fixperms --exclude npm-cli.js --exclude npx-cli.js

override_dh_auto_test:
override_dh_auto_clean:
