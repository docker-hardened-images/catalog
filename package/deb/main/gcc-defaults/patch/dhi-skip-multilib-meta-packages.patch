Skip gcc-defaults metapackages that cannot co-install with HSP gcc-14.

Multilib, foreign cross, Go, D, Modula-2, hppa64, and GPU offload metapackages
pin exact gcc-14-base versions from Debian main or depend on binaries omitted
from the HSP gcc-14 build profile (host-triplet compilers only).
Upstream source: https://salsa.debian.org/toolchain-team/gcc-defaults

diff --git a/debian/rules b/debian/rules
--- a/debian/rules
+++ b/debian/rules
@@ -409,6 +409,9 @@
     )
 endif
 
+# DHI: HSP gcc-14 builds host-triplet compilers only; disable foreign cross metapackages.
+CROSS_ARCHS :=
+
 ifeq ($(SOURCE),gcc-defaults)
   with_native = yes
 endif
@@ -461,14 +464,12 @@
   with_multiarch_lib := yes
 endif
 
