+no_packages += gcc-multilib g++-multilib gfortran-multilib gobjc-multilib gobjc++-multilib \
+  gdc-multilib gccgo-multilib gcc-hppa64-linux-gnu gcc-offload-nvptx gcc-offload-amdgcn \
+  gccgo gccgo$(NATIVE_SUFFIX) gccgo-for-host gccgo-for-build gccgo-doc gdc gdc$(NATIVE_SUFFIX) gdc-for-host gdc-for-build \
+  libgphobos-dev gm2 gm2$(NATIVE_SUFFIX) gm2-for-host gm2-for-build gm2-doc
+multilib_archs :=
 
 ifeq ($(with_native),yes)
   ifeq (,$(filter $(DEB_HOST_ARCH),$(go_archs)))
