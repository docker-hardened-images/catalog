# DHI build images inject OTEL_EXPORTER_OTLP_* endpoint defaults (for example
# unix:///dev/otel-grpc.sock) that take precedence over generic OTEL_EXPORTER_OTLP_*
# variables and break upstream exporter ConfigFromEnv unit tests.
# Upstream debian/rules: https://salsa.debian.org/science-team/opentelemetry-cpp/-/blob/debian/1.19.0-3/debian/rules
# Debian source package: https://packages.debian.org/source/trixie/opentelemetry-cpp
--- a/debian/rules
+++ b/debian/rules
@@ -32,10 +32,26 @@ override_dh_auto_install:
 #
 # Some curl-related tests fail when running on multiple CPU cores.
+# DHI build images inject OTEL_EXPORTER_OTLP_* endpoint defaults that break
+# upstream unit tests which setenv their own OTEL_EXPORTER_OTLP_* values.
+OTEL_ENV_UNSET = env \
+	-u OTEL_EXPORTER_OTLP_ENDPOINT \
+	-u OTEL_EXPORTER_OTLP_PROTOCOL \
+	-u OTEL_EXPORTER_OTLP_TRACES_ENDPOINT \
+	-u OTEL_EXPORTER_OTLP_TRACES_PROTOCOL \
+	-u OTEL_EXPORTER_OTLP_METRICS_ENDPOINT \
+	-u OTEL_EXPORTER_OTLP_METRICS_PROTOCOL \
+	-u OTEL_EXPORTER_OTLP_LOGS_ENDPOINT \
+	-u OTEL_EXPORTER_OTLP_LOGS_PROTOCOL \
+	-u OTEL_EXPORTER_OTLP_INSECURE \
+	-u OTEL_EXPORTER_OTLP_TRACES_INSECURE \
+	-u OTEL_EXPORTER_OTLP_METRICS_INSECURE \
+	-u OTEL_EXPORTER_OTLP_LOGS_INSECURE
+
 override_dh_auto_test:
 ifneq (,$(filter $(DEB_HOST_ARCH), amd64 mips64el ppc64el))
-	dh_auto_test --max-parallel=1
+	$(OTEL_ENV_UNSET) dh_auto_test --max-parallel=1
 else
-	dh_auto_test --max-parallel=1 || true
+	$(OTEL_ENV_UNSET) dh_auto_test --max-parallel=1 || true
 endif
 
 override_dh_auto_clean:
