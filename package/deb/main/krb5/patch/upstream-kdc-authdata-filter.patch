Subject: Exclude nested AD-IF-RELEVANT authdata in KDC
Origin: upstream, https://github.com/krb5/krb5/commit/8137e349a9c1710de36246d27f5db95ddcd128d2
CVE: CVE-2026-71199
CVE: CVE-2026-111423
Base-Tree: debian krb5 1.21.3-5+deb13u1

Companion KDC authdata filtering change shipped with the PAC and CAMMAC fixes in MITKRB5-SA-2026-001.

diff --git a/src/kdc/kdc_authdata.c b/src/kdc/kdc_authdata.c
index 398df21..0ebd235 100644
--- a/src/kdc/kdc_authdata.c
+++ b/src/kdc/kdc_authdata.c
@@ -106,10 +106,9 @@ unload_authdata_plugins(krb5_context context)
 }
 
 /* Return true if authdata should be filtered when copying from untrusted
- * authdata.  If desired_type is non-zero, look only for that type. */
+ * authdata. */
 static krb5_boolean
-is_kdc_issued_authdatum(krb5_authdata *authdata,
-                        krb5_authdatatype desired_type)
+is_kdc_issued_authdatum(krb5_authdata *authdata)
 {
     krb5_boolean result = FALSE;
     krb5_authdatatype ad_type;
@@ -134,7 +133,12 @@ is_kdc_issued_authdatum(krb5_authdata *authdata,
         case KRB5_AUTHDATA_WIN2K_PAC:
         case KRB5_AUTHDATA_CAMMAC:
         case KRB5_AUTHDATA_AUTH_INDICATOR:
-            result = desired_type ? (desired_type == ad_types[i]) : TRUE;
+            result = TRUE;
+            break;
+        case KRB5_AUTHDATA_IF_RELEVANT:
+            /* Assume nested AD-IF-RELEVANT containers are trying to hide
+             * KDC-issued authdata and filter them out. */
+            result = TRUE;
             break;
         default:
             result = FALSE;
@@ -216,7 +220,7 @@ add_filtered_authdata(krb5_authdata ***existing_list,
     /* Remove KDC-issued elements from copy. */
     j = 0;
     for (i = 0; copy[i] != NULL; i++) {
-        if (is_kdc_issued_authdatum(copy[i], 0)) {
+        if (is_kdc_issued_authdatum(copy[i])) {
             free(copy[i]->contents);
             free(copy[i]);
         } else {
diff --git a/src/tests/t_authdata.py b/src/tests/t_authdata.py
index bde1c36..c46d312 100644
--- a/src/tests/t_authdata.py
+++ b/src/tests/t_authdata.py
@@ -26,6 +26,14 @@ if ' -5: test1' not in out or '?-6: test2' not in out:
 if 'fake' in out:
     fail('KDC-only authdata not filtered for request with authdata')
 
+# Nested if-relevant containers are also filtered, whether or not they
+# contain KDC-only authdata types.
+mark('request authdata nested')
+out = realm.run(['./adata', realm.host_princ, '??-7', 'nested',
+                 '??128', 'nestedfakepac', '???^-8', 'nestedfakekdcissued'])
+if 'nested' in out or 'fake' in out:
+    fail('Nested authdata not filtered for request with authdata')
+
 mark('AD-MANDATORY-FOR-KDC')
 realm.run(['./adata', realm.host_princ, '!-1', 'mandatoryforkdc'],
           expected_code=1, expected_msg='KDC policy rejects request')
