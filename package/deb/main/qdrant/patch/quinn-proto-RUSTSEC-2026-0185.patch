# DHI security fix: pin quinn-proto to 0.11.15 (RUSTSEC-2026-0185 / GHSA-4w2j-m93h-cj5j).
#
# Advisory: https://rustsec.org/advisories/RUSTSEC-2026-0185.html
# GHSA:     https://github.com/advisories/GHSA-4w2j-m93h-cj5j
#
# "Remote memory exhaustion in quinn-proto from unbounded out-of-order
# stream reassembly" (HIGH). Affected < 0.11.15; patched 0.11.15. Upstream qdrant
# v1.18.3 locks quinn-proto at 0.11.14 (still affected), so this Cargo.lock delta
# bumps it to 0.11.15. quinn-proto is a transitive dependency (absent from qdrant's
# Cargo.toml), so the fix lives in the lockfile rather than a manifest edit.
#
# Regenerate on version bump: in a checkout of the target qdrant tag, run
#   cargo update --ignore-rust-version -p quinn-proto --precise 0.11.15
# then `git diff -- Cargo.lock`. Scope is a single crate (version + checksum);
# `cargo build --locked` in the pipeline then verifies no further drift.
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -5913,9 +5913,9 @@
 
 [[package]]
 name = "quinn-proto"
-version = "0.11.14"
+version = "0.11.15"
 source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "434b42fec591c96ef50e21e886936e66d3cc3f737104fdb9b737c40ffb94c098"
+checksum = "4fcb935c5bec503c2f0e306bdd3e58bb9029dcb14fa8d9ac76e3a5256ac0763e"
 dependencies = [
  "aws-lc-rs",
  "bytes",
