#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_configure:

override_dh_auto_build:

override_dh_auto_test:

override_dh_auto_clean:

override_dh_auto_install:
	cp -a install-root/. debian/tmp/

override_dh_missing:
	dh_missing --list-missing

# The php-X.Y-src tree is the pristine upstream tarball and its tests/ dirs hold
# deliberately corrupt zip and png fixtures that make the normalizer abort.
override_dh_strip_nondeterminism:
	dh_strip_nondeterminism -Xusr/src/
